# RUN: llc -mtriple=shle-unknown-none-elf -mcpu=sh2 -O2 -run-pass=prolog-epilog -verify-machineinstrs %s -o - | FileCheck %s

--- |
  define i32 @scaled_large_frame_offset() { ret i32 0 }
...
---
name: scaled_large_frame_offset
tracksRegLiveness: true
noVRegs: true
fixedStack:
  - { id: 0, type: default, offset: 300, size: 4, alignment: 4, isImmutable: true }
body: |
  bb.0:
    $r0 = MOVL_load_disp %fixed-stack.0, 0 :: (load (s32) from %fixed-stack.0)
    RTS implicit $pr, implicit $r0
...

# CHECK: $r0 = MOVri 1
# CHECK-NEXT: $r0 = SHLL8 $r0
# CHECK-NEXT: $r0 = ADDri $r0, 44
# CHECK-NEXT: $r0 = MOVL_load_indexed $r15, implicit killed $r0
