name: sequential_tables
alignment: 8
tracksRegLiveness: true
noVRegs: true
jumpTable:
  kind: inline
  entries:
    - id: 0
      blocks: [ '%bb.2' ]
    - id: 1
      blocks: [ '%bb.4' ]
body: |
  bb.0:
    successors: %bb.2
    liveins: $r4, $r5, $pr
    $r0 = MOVA <mcsymbol .Lseq_table0>
    $r4 = SHLL2 killed $r4
    $r1 = MOVL_load_indexed killed $r4, implicit killed $r0 :: (dereferenceable invariant load (s32) from jump-table)
    BRAF killed $r1, %jump-table.0, <mcsymbol .Lseq_base0>
  bb.1 (align 4):
    successors:
    SH_JUMPTABLE %jump-table.0, <mcsymbol .Lseq_table0>, <mcsymbol .Lseq_base0>, 4
  bb.2:
    successors: %bb.4
    liveins: $r5, $pr
    $r0 = MOVA <mcsymbol .Lseq_table1>
    $r5 = SHLL2 killed $r5
    $r1 = MOVL_load_indexed killed $r5, implicit killed $r0 :: (dereferenceable invariant load (s32) from jump-table)
    BRAF killed $r1, %jump-table.1, <mcsymbol .Lseq_base1>
  bb.3 (align 4):
    successors:
    SH_JUMPTABLE %jump-table.1, <mcsymbol .Lseq_table1>, <mcsymbol .Lseq_base1>, 4
  bb.4:
    successors: %bb.5, %bb.6
    liveins: $pr
    SETT implicit-def $tbit
    BF %bb.6, implicit killed $tbit
  bb.5:
    successors: %bb.6
    liveins: $pr
    INLINEASM &".space 252", sideeffect attdialect
  bb.6 (align 8):
    liveins: $pr
    RTS implicit $pr
...
---
name: literal_island
alignment: 4
tracksRegLiveness: true
noVRegs: true
constants:
  - id: 0
    value: 'i32 42'
    alignment: 4
jumpTable:
  kind: inline
  entries:
    - id: 0
      blocks: [ '%bb.2', '%bb.2', '%bb.2', '%bb.2', '%bb.2' ]
body: |
  bb.0:
    successors: %bb.2
    liveins: $r4, $pr
    dead $r2 = MOVL_load_pc_island %const.0, 0 :: (dereferenceable invariant load (s32) from constant-pool)
    $r0 = MOVA <mcsymbol .Lliteral_island_table>
    $r4 = SHLL2 killed $r4
    $r1 = MOVL_load_indexed killed $r4, implicit killed $r0 :: (dereferenceable invariant load (s32) from jump-table)
    BRAF killed $r1, %jump-table.0, <mcsymbol .Lliteral_island_base>
  bb.1 (align 4):
    successors:
    SH_JUMPTABLE %jump-table.0, <mcsymbol .Lliteral_island_table>, <mcsymbol .Lliteral_island_base>, 4
  bb.2:
    successors: %bb.3, %bb.5
    liveins: $pr
    SETT implicit-def $tbit
    BF %bb.5, implicit killed $tbit
  bb.3:
    successors: %bb.5
    liveins: $pr
    INLINEASM &".space 248", sideeffect attdialect
    BRA %bb.5
  bb.4 (align 4):
    successors:
    SH_CONSTPOOL_ENTRY %const.0, 0, 4, 4
  bb.5 (align 4):
    liveins: $pr
    RTS implicit $pr
...
---
name: compression_then_filling
alignment: 4
tracksRegLiveness: true
noVRegs: true
jumpTable:
  kind: inline
  entries:
    - id: 0
      blocks: [ '%bb.2', '%bb.2', '%bb.2', '%bb.2' ]
body: |
  bb.0:
    successors: %bb.2
    liveins: $r4, $r5, $pr
    $r0 = MOVA <mcsymbol .Lfill_table>
    $r4 = SHLL2 killed $r4
    $r1 = MOVL_load_indexed killed $r4, implicit killed $r0 :: (dereferenceable invariant load (s32) from jump-table)
    BRAF killed $r1, %jump-table.0, <mcsymbol .Lfill_base>
  bb.1 (align 4):
    successors:
    SH_JUMPTABLE %jump-table.0, <mcsymbol .Lfill_table>, <mcsymbol .Lfill_base>, 4
  bb.2:
    successors: %bb.3
    liveins: $r5, $pr
    SETT implicit-def $tbit
    $r1 = MOVrr $r5
    BRA %bb.3
  bb.3:
    successors: %bb.4, %bb.6
    liveins: $pr, $tbit
    BF %bb.6, implicit killed $tbit
  bb.4:
    successors: %bb.5
    liveins: $pr
    INLINEASM &".space 254", sideeffect attdialect
  bb.5 (align 4):
    successors: %bb.6
    liveins: $pr
    NOP
  bb.6:
    liveins: $pr
    RTS implicit $pr
...
