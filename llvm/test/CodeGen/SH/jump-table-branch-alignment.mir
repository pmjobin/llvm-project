name: backward_bf
alignment: 4
tracksRegLiveness: true
noVRegs: true
jumpTable:
  kind: inline
  entries:
    - id: 0
      blocks: [ '%bb.2', '%bb.2', '%bb.2', '%bb.2', '%bb.2' ]
body: |
  bb.0:
    successors: %bb.2
    liveins: $r4, $pr
    $r0 = MOVA <mcsymbol .Lbackward_bf_table>
    $r4 = SHLL2 killed $r4
    $r1 = MOVL_load_indexed killed $r4, implicit killed $r0 :: (dereferenceable invariant load (s32) from jump-table)
    BRAF killed $r1, %jump-table.0, <mcsymbol .Lbackward_bf_base>
  bb.1 (align 4):
    successors:
    SH_JUMPTABLE %jump-table.0, <mcsymbol .Lbackward_bf_table>, <mcsymbol .Lbackward_bf_base>, 4
  bb.2:
    successors: %bb.3
    liveins: $pr
    NOP
  bb.3:
    successors: %bb.4
    liveins: $pr
    INLINEASM &".space 246", sideeffect attdialect
  bb.4 (align 4):
    successors: %bb.2, %bb.5
    liveins: $pr
    SETT implicit-def $tbit
    NOP
    BF %bb.2, implicit killed $tbit
  bb.5:
    liveins: $pr
    RTS implicit $pr
...
