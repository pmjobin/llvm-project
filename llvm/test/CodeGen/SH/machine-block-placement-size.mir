# RUN: llc -mtriple=sh-unknown-elf -mcpu=sh2 -run-pass=block-placement -verify-machineinstrs %s -o - | FileCheck %s

--- |
  define i32 @size(i32 %a, i32 %b) optsize {
    ret i32 %a
  }

  define i32 @speed(i32 %a, i32 %b) {
    ret i32 %a
  }
...
---
name:            size
tracksRegLiveness: true
noVRegs:         true
body:             |
  bb.0:
    successors: %bb.1(0x0147ae14), %bb.2(0x7eb851ec)
    liveins: $r4, $r5

    CMP_EQ $r5, $r4, implicit-def $tbit
    BT %bb.1, implicit $tbit
    BRA %bb.2

  bb.1:
    $r0 = MOVri 1
    BRA %bb.3

  bb.2:
    $r0 = MOVri 2
    BRA %bb.3

  bb.3:
    liveins: $r0

    RTS implicit $pr, implicit $r0
...
---
name:            speed
tracksRegLiveness: true
noVRegs:         true
body:             |
  bb.0:
    successors: %bb.1(0x0147ae14), %bb.2(0x7eb851ec)
    liveins: $r4, $r5

    CMP_EQ $r5, $r4, implicit-def $tbit
    BT %bb.1, implicit $tbit
    BRA %bb.2

  bb.1:
    $r0 = MOVri 1
    BRA %bb.3

  bb.2:
    $r0 = MOVri 2
    BRA %bb.3

  bb.3:
    liveins: $r0

    RTS implicit $pr, implicit $r0
...

# CHECK-LABEL: name:            size
# CHECK: bb.0:
# CHECK: CMP_EQ
# CHECK-NEXT: BT %bb.1
# CHECK-NOT: BRA
# CHECK: bb.2:
# CHECK: $r0 = MOVri 2
# CHECK-NEXT: RTS
# CHECK: bb.1:
# CHECK: $r0 = MOVri 1
# CHECK-NEXT: RTS

# CHECK-LABEL: name:            speed
# CHECK: bb.0:
# CHECK: CMP_EQ
# CHECK-NEXT: BT %bb.1
# CHECK-NOT: BRA
# CHECK: bb.2:
# CHECK: $r0 = MOVri 2
# CHECK-NEXT: RTS
# CHECK: bb.1:
# CHECK: $r0 = MOVri 1
# CHECK-NEXT: RTS
