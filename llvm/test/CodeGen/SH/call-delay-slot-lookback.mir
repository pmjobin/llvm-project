# CHECK-LABEL: name:            independent_argument
# CHECK-NOT: $r6 = ADDri
# CHECK: JSR $r1, csr_sh,{{.*}} {
# CHECK-NEXT: $r6 = ADDri $r6, 1
# CHECK-NEXT: }

# CHECK-LABEL: name:            last_in_bound
# CHECK-NOT: $r6 = ADDri
# CHECK: JSR $r1, csr_sh,{{.*}} {
# CHECK-NEXT: $r6 = ADDri $r6, 1
# CHECK-NEXT: }

# CHECK-LABEL: name:            outside_bound
# CHECK: $r6 = ADDri $r6, 1
# CHECK: JSR $r1, csr_sh,{{.*}} {
# CHECK-NEXT: NOP
# CHECK-NEXT: }

# CHECK-LABEL: name:            size_control
