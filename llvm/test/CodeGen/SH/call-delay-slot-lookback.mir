# CHECK-NEXT: NOP
# CHECK-NEXT: }

# CHECK-LABEL: name:            argument_used_by_target
# CHECK: $r6 = ADDri $r6, 1
# CHECK: JSR $r1, csr_sh,{{.*}} {
# CHECK-NEXT: NOP
# CHECK-NEXT: }

