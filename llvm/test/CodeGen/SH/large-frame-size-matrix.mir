# CHECK: $r15 = frame-destroy ADDrr $r15, killed $r3

# CHECK-LABEL: name:            frame_32768
# CHECK: stackSize:       32768
# CHECK: $r3 = frame-setup MOVri -128
# CHECK-NEXT: $r3 = frame-setup SHLL8 $r3
# CHECK-NEXT: $r3 = frame-setup EXTUW $r3
# CHECK-NEXT: $r15 = frame-setup SUBrr $r15, killed $r3
# CHECK: $r15 = frame-destroy ADDrr $r15, killed $r3

# CHECK-LABEL: name:            frame_65536
# CHECK: stackSize:       65536
# CHECK: $r3 = frame-setup MOVri 1
# CHECK-NEXT: $r3 = frame-setup SHLL16 $r3
# CHECK-NEXT: $r15 = frame-setup SUBrr $r15, killed $r3
