# CHECK-LABEL: name:            frame_252
# CHECK: stackSize:       252
# CHECK: $r15 = frame-setup ADDri $r15, -128
# CHECK-NEXT: frame-setup CFI_INSTRUCTION def_cfa_offset 128
# CHECK-NEXT: $r15 = frame-setup ADDri $r15, -124
# CHECK-NEXT: frame-setup CFI_INSTRUCTION def_cfa_offset 252
# CHECK: $r15 = frame-destroy ADDri $r15, 127
# CHECK: $r15 = frame-destroy ADDri $r15, 125

# CHECK-LABEL: name:            frame_256
# CHECK: stackSize:       256
# CHECK: $r15 = frame-setup ADDri $r15, -128
# CHECK: $r15 = frame-setup ADDri $r15, -128
# CHECK: $r15 = frame-destroy ADDri $r15, 127
# CHECK: $r15 = frame-destroy ADDri $r15, 127
# CHECK: $r15 = frame-destroy ADDri $r15, 2

# CHECK-LABEL: name:            frame_260
# CHECK: stackSize:       260
# CHECK: $r3 = frame-setup MOVri 1
# CHECK-NEXT: $r3 = frame-setup SHLL8 $r3
# CHECK-NEXT: $r3 = frame-setup ADDri $r3, 4
# CHECK-NEXT: $r15 = frame-setup SUBrr $r15, killed $r3
# CHECK-NEXT: frame-setup CFI_INSTRUCTION def_cfa_offset 260
# CHECK: $r3 = frame-destroy MOVri 1
# CHECK-NEXT: $r3 = frame-destroy SHLL8 $r3
# CHECK-NEXT: $r3 = frame-destroy ADDri $r3, 4
# CHECK-NEXT: $r15 = frame-destroy ADDrr $r15, killed $r3
# CHECK-NEXT: frame-destroy CFI_INSTRUCTION def_cfa_offset 0

# CHECK-LABEL: name:            frame_384
# CHECK: stackSize:       384
# CHECK: $r15 = frame-setup SUBrr $r15, killed $r3
# CHECK: $r15 = frame-destroy ADDrr $r15, killed $r3

# CHECK-LABEL: name:            frame_512
# CHECK: stackSize:       512
# CHECK: $r15 = frame-setup SUBrr $r15, killed $r3
# CHECK: $r15 = frame-destroy ADDrr $r15, killed $r3

