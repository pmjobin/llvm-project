# RUN: llc -mtriple=shle -mcpu=sh4 -stack-symbol-ordering=0 -verify-machineinstrs -run-pass=prolog-epilog %s -o /dev/null
# RUN: llc -mtriple=sh -mcpu=sh4 -stack-symbol-ordering=0 -verify-machineinstrs -run-pass=prolog-epilog %s -o /dev/null
# A vector-only frame access must reserve the emergency GPR slot even in a
# small frame without FR12-FR15 saves. Every GPR is live across the transfer.
--- |
  define void @vector_load_pressure() "target-abi"="gnu-hard-float" { ret void }
...
---
name: vector_load_pressure
tracksRegLiveness: true
noVRegs: true
stack:
  - { id: 0, type: spill-slot, size: 16, alignment: 4 }
body: |
  bb.0:
    liveins: $r0, $r1, $r2, $r3, $r4, $r5, $r6, $r7, $r8, $r9, $r10, $r11, $r12, $r13, $r14, $fv0, $fpscr, $pr
    $fv0 = FMOV_V_LOAD_FI %stack.0, 0, implicit $fpscr :: (load (s128) from %stack.0, align 4)
    RTS implicit $pr, implicit $fv0, implicit $r0, implicit $r1, implicit $r2, implicit $r3, implicit $r4, implicit $r5, implicit $r6, implicit $r7, implicit $r8, implicit $r9, implicit $r10, implicit $r11, implicit $r12, implicit $r13, implicit $r14
...
