# RUN: llc -mtriple=sh-unknown-elf -mcpu=sh2 -verify-machineinstrs -run-pass=sh-postra-peephole %s -o - | FileCheck %s
# RUN: llc -mtriple=shle-unknown-elf -mcpu=sh4 -verify-machineinstrs -run-pass=sh-postra-peephole %s -o - | FileCheck %s

--- |
  define void @fold_long_result_in_r0(ptr %p) { ret void }
  define void @fold_byte_negative_index(ptr %p) { ret void }
  define void @fold_word_stack_base(ptr %p) { ret void }
  define void @fold_overwritten_base(ptr %p) { ret void }
  define void @keep_live_r0(ptr %p) { ret void }
  define void @keep_large_index(ptr %p) { ret void }
  define void @keep_intervening_instruction(ptr %p) { ret void }
  define void @keep_flagged_copy(ptr %p) { ret void }
  define void @fold_long_store(ptr %p) { ret void }
  define void @fold_same_source_and_base(ptr %p) { ret void }
  define void @fold_byte_store_to_stack(ptr %p) { ret void }
  define void @keep_r0_store_value(ptr %p) { ret void }
  define void @keep_live_store_address(ptr %p) { ret void }
  define void @keep_jti_dispatch(ptr %p) { ret void }
...
---
name:            fold_long_result_in_r0
tracksRegLiveness: true
noVRegs:         true
body:             |
  bb.0:
    liveins: $r8

    $r0 = MOVrr $r8
    $r0 = nuw ADDri killed $r0, 64
    dead $r0 = MOVL_load_reg killed $r0 :: (volatile load (s32) from %ir.p)
...

# CHECK-LABEL: name:            fold_long_result_in_r0
# CHECK-NOT: MOVrr
# CHECK-NOT: ADDri
# CHECK: $r0 = MOVri 64
# CHECK-NEXT: dead $r0 = MOVL_load_indexed $r8, implicit killed $r0 :: (volatile load (s32) from %ir.p)

---
name:            fold_byte_negative_index
tracksRegLiveness: true
noVRegs:         true
body:             |
  bb.0:
    liveins: $r3

    $r0 = MOVrr killed $r3
    $r0 = ADDri killed $r0, -1
    dead $r2 = MOVB_load_reg killed $r0 :: (load (s8) from %ir.p)
...

# CHECK-LABEL: name:            fold_byte_negative_index
# CHECK-NOT: MOVrr
# CHECK-NOT: ADDri
# CHECK: $r0 = MOVri -1
# CHECK-NEXT: dead $r2 = MOVB_load_indexed killed $r3, implicit killed $r0 :: (load (s8) from %ir.p)

---
name:            fold_word_stack_base
tracksRegLiveness: true
noVRegs:         true
body:             |
  bb.0:
    liveins: $r15

    $r0 = MOVrr $r15
    $r0 = nsw ADDri killed $r0, 124
    dead $r4 = MOVW_load_reg killed $r0 :: (load (s16) from %ir.p)
...

# CHECK-LABEL: name:            fold_word_stack_base
# CHECK-NOT: MOVrr
# CHECK-NOT: ADDri
# CHECK: $r0 = MOVri 124
# CHECK-NEXT: dead $r4 = MOVW_load_indexed $r15, implicit killed $r0 :: (load (s16) from %ir.p)

---
name:            fold_overwritten_base
tracksRegLiveness: true
noVRegs:         true
body:             |
  bb.0:
    liveins: $r2

    $r0 = MOVrr killed $r2
    $r0 = ADDri killed $r0, -128
    dead $r2 = MOVL_load_reg killed $r0 :: (load (s32) from %ir.p)
...

# CHECK-LABEL: name:            fold_overwritten_base
# CHECK-NOT: MOVrr
# CHECK-NOT: ADDri
# CHECK: $r0 = MOVri -128
# CHECK-NEXT: dead $r2 = MOVL_load_indexed killed $r2, implicit killed $r0 :: (load (s32) from %ir.p)

---
name:            keep_live_r0
tracksRegLiveness: true
noVRegs:         true
body:             |
  bb.0:
    liveins: $r5

    $r0 = MOVrr $r5
    $r0 = ADDri killed $r0, 64
    dead $r3 = MOVL_load_reg $r0 :: (load (s32) from %ir.p)
    dead $r4 = MOVrr killed $r0
...

# CHECK-LABEL: name:            keep_live_r0
# CHECK: $r0 = MOVrr $r5
# CHECK-NEXT: $r0 = ADDri killed $r0, 64
# CHECK-NEXT: dead $r3 = MOVL_load_reg $r0

---
name:            keep_large_index
tracksRegLiveness: true
noVRegs:         true
body:             |
  bb.0:
    liveins: $r6

    $r0 = MOVrr killed $r6
    $r0 = ADDri killed $r0, 128
    dead $r0 = MOVL_load_reg killed $r0 :: (load (s32) from %ir.p)
...

# CHECK-LABEL: name:            keep_large_index
# CHECK: $r0 = MOVrr killed $r6
# CHECK-NEXT: $r0 = ADDri killed $r0, 128
# CHECK-NEXT: dead $r0 = MOVL_load_reg killed $r0

---
name:            keep_intervening_instruction
tracksRegLiveness: true
noVRegs:         true
body:             |
  bb.0:
    liveins: $r7

    $r0 = MOVrr killed $r7
    NOP
    $r0 = ADDri killed $r0, 64
    dead $r0 = MOVL_load_reg killed $r0 :: (load (s32) from %ir.p)
...

# CHECK-LABEL: name:            keep_intervening_instruction
# CHECK: $r0 = MOVrr killed $r7
# CHECK-NEXT: NOP
# CHECK-NEXT: $r0 = ADDri killed $r0, 64

---
name:            keep_flagged_copy
tracksRegLiveness: true
noVRegs:         true
body:             |
  bb.0:
    liveins: $r8

    $r0 = frame-setup MOVrr killed $r8
    $r0 = ADDri killed $r0, 64
    dead $r0 = MOVL_load_reg killed $r0 :: (load (s32) from %ir.p)
...

# CHECK-LABEL: name:            keep_flagged_copy
# CHECK: $r0 = frame-setup MOVrr killed $r8
# CHECK-NEXT: $r0 = ADDri killed $r0, 64

---
name:            fold_long_store
tracksRegLiveness: true
noVRegs:         true
body:             |
  bb.0:
    liveins: $r8, $r10

    $r0 = MOVrr killed $r8
    $r0 = ADDri killed $r0, 88
    MOVL_store_reg killed $r10, killed $r0 :: (volatile store (s32) into %ir.p)
...

# CHECK-LABEL: name:            fold_long_store
# CHECK-NOT: MOVrr
# CHECK-NOT: ADDri
# CHECK: $r0 = MOVri 88
# CHECK-NEXT: MOVL_store_indexed killed $r10, killed $r8, implicit killed $r0 :: (volatile store (s32) into %ir.p)

---
name:            fold_same_source_and_base
tracksRegLiveness: true
noVRegs:         true
body:             |
  bb.0:
    liveins: $r9

    $r0 = MOVrr $r9
    $r0 = ADDri killed $r0, -12
    MOVW_store_reg killed $r9, killed $r0 :: (store (s16) into %ir.p)
...

# CHECK-LABEL: name:            fold_same_source_and_base
# CHECK-NOT: MOVrr
# CHECK-NOT: ADDri
# CHECK: $r0 = MOVri -12
# CHECK-NEXT: MOVW_store_indexed $r9, killed $r9, implicit killed $r0 :: (store (s16) into %ir.p)

---
name:            fold_byte_store_to_stack
tracksRegLiveness: true
noVRegs:         true
body:             |
  bb.0:
    liveins: $r3, $r15

    $r0 = MOVrr $r15
    $r0 = ADDri killed $r0, 17
    MOVB_store_reg killed $r3, killed $r0 :: (store (s8) into %ir.p)
...

# CHECK-LABEL: name:            fold_byte_store_to_stack
# CHECK-NOT: MOVrr
# CHECK-NOT: ADDri
# CHECK: $r0 = MOVri 17
# CHECK-NEXT: MOVB_store_indexed killed $r3, $r15, implicit killed $r0 :: (store (s8) into %ir.p)

---
name:            keep_r0_store_value
tracksRegLiveness: true
noVRegs:         true
body:             |
  bb.0:
    liveins: $r0, $r4

    $r0 = MOVrr killed $r4
    $r0 = ADDri killed $r0, 64
    MOVL_store_reg $r0, killed $r0 :: (store (s32) into %ir.p)
...

# CHECK-LABEL: name:            keep_r0_store_value
# CHECK: $r0 = MOVrr killed $r4
# CHECK-NEXT: $r0 = ADDri killed $r0, 64
# CHECK-NEXT: MOVL_store_reg $r0, killed $r0

---
name:            keep_live_store_address
tracksRegLiveness: true
noVRegs:         true
body:             |
  bb.0:
    liveins: $r5, $r6

    $r0 = MOVrr killed $r5
    $r0 = ADDri killed $r0, 64
    MOVL_store_reg killed $r6, $r0 :: (store (s32) into %ir.p)
    dead $r7 = MOVrr killed $r0
...

# CHECK-LABEL: name:            keep_live_store_address
# CHECK: $r0 = MOVrr killed $r5
# CHECK-NEXT: $r0 = ADDri killed $r0, 64
# CHECK-NEXT: MOVL_store_reg killed $r6, $r0

---
name:            keep_jti_dispatch
tracksRegLiveness: true
noVRegs:         true
jumpTable:
  kind:            inline
  entries:
    - id:              0
      blocks:          [ '%bb.1' ]
body:             |
  bb.0:
    successors: %bb.1(0x80000000)
    liveins: $r8

    $r0 = MOVrr killed $r8
    $r0 = ADDri killed $r0, 64
    $r0 = MOVL_load_reg killed $r0 :: (dereferenceable invariant load (s32) from jump-table)
    JMP killed $r0, %jump-table.0

  bb.1:
    RTS implicit $pr
...

# CHECK-LABEL: name:            keep_jti_dispatch
# CHECK: $r0 = MOVrr killed $r8
# CHECK-NEXT: $r0 = ADDri killed $r0, 64
# CHECK-NEXT: $r0 = MOVL_load_reg killed $r0
# CHECK-NEXT: JMP killed $r0, %jump-table.0
