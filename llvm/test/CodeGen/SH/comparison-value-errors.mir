# RUN: split-file %s %t
# RUN: not llc -x mir -mtriple=sh-unknown-elf -run-pass=finalize-isel %t/bad-predicate.mir -o /dev/null 2>&1 | FileCheck %s --check-prefix=BAD-PREDICATE
# RUN: not --crash llc -x mir -mtriple=shle-unknown-elf -run-pass=none -verify-machineinstrs -filetype=null %t/bad-select.mir -o /dev/null 2>&1 | FileCheck %s --check-prefix=BAD-SELECT
# RUN: not llc -x mir -mtriple=sh-unknown-elf -run-pass=none -verify-machineinstrs %t/missing-t-use.mir -o /dev/null 2>&1 | FileCheck %s --check-prefix=MISSING-T

# BAD-PREDICATE: LLVM ERROR: SH integer comparison predicate is not supported
# BAD-SELECT: Bad machine code: Too few operands
# BAD-SELECT: instruction: %3:gpr = SELECT_PSEUDO %0:gpr, %1:gpr
# MISSING-T: missing implicit register operand 'implicit $tbit'

#--- bad-predicate.mir
--- |
  define i32 @bad_predicate() {
    ret i32 0
  }
...
---
name:            bad_predicate
tracksRegLiveness: true
body:             |
  bb.0:
    liveins: $r4, $r5, $r6, $r7

    %0:gpr = COPY $r4
    %1:gpr = COPY $r5
    %2:gpr = COPY $r6
    %3:gpr = COPY $r7
    %4:gpr = SELECT_CC_PSEUDO %0, %1, %2, %3, 999
    $r0 = COPY %4
    RTS implicit $pr, implicit $r0
...

#--- bad-select.mir
--- |
  define i32 @bad_select() {
    ret i32 0
  }
...
---
name:            bad_select
tracksRegLiveness: true
body:             |
  bb.0:
    liveins: $r4, $r5, $r6

    %0:gpr = COPY $r4
    %1:gpr = COPY $r5
    %2:gpr = COPY $r6
    %3:gpr = SELECT_PSEUDO %0, %1
    $r0 = COPY %3
    RTS implicit $pr, implicit $r0
...

#--- missing-t-use.mir
--- |
  define i32 @missing_t_use() {
    ret i32 0
  }
...
---
name:            missing_t_use
tracksRegLiveness: true
noVRegs:         true
body:             |
  bb.0:
    $r0 = MOVT
    RTS implicit $pr, implicit $r0
...
