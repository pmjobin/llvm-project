# RUN: llc -mtriple=sh-unknown-elf -mcpu=sh2 -verify-machineinstrs -run-pass=prolog-epilog %s -o - | FileCheck %s
# RUN: llc -mtriple=sh-unknown-elf -mcpu=sh3 -verify-machineinstrs -run-pass=prolog-epilog %s -o - | FileCheck %s
# RUN: llc -mtriple=sh-unknown-elf -mcpu=sh4 -verify-machineinstrs -run-pass=prolog-epilog %s -o - | FileCheck %s
# RUN: llc -mtriple=sh-unknown-elf -mcpu=sh2 -verify-machineinstrs -run-pass=prolog-epilog %s -o %t.mir
# RUN: llc -mtriple=sh-unknown-elf -mcpu=sh2 -verify-machineinstrs -start-after=prolog-epilog -filetype=obj %t.mir -o /dev/null

--- |
  define void @far_long_load() optsize { ret void }
  define void @far_byte_load() optsize { ret void }
  define void @far_word_load() optsize { ret void }
...
---
name:            far_long_load
tracksRegLiveness: true
noVRegs:         true
fixedStack:
  - { id: 0, type: default, offset: 1000, size: 4, alignment: 4,
      isImmutable: true }
body:             |
  bb.0:
    dead $r1 = MOVL_load_disp %fixed-stack.0, 0 :: (load (s32) from %fixed-stack.0)
    RTS implicit $pr
...
---
name:            far_byte_load
tracksRegLiveness: true
noVRegs:         true
fixedStack:
  - { id: 0, type: default, offset: 1001, size: 1, alignment: 1,
      isImmutable: true }
body:             |
  bb.0:
    dead $r2 = MOVB_load_frame %fixed-stack.0, 0, implicit-def dead early-clobber $r0 :: (load (s8) from %fixed-stack.0)
    RTS implicit $pr
...
---
name:            far_word_load
tracksRegLiveness: true
noVRegs:         true
fixedStack:
  - { id: 0, type: default, offset: 1002, size: 2, alignment: 2,
      isImmutable: true }
body:             |
  bb.0:
    dead $r3 = MOVW_load_frame %fixed-stack.0, 0, implicit-def dead early-clobber $r0 :: (load (s16) from %fixed-stack.0)
    RTS implicit $pr
...

# CHECK-LABEL: name:            far_long_load
# CHECK-LABEL: body:
# CHECK: $r0 = MOVW_load_pc_island %const.{{[0-9]+}}, -1
# CHECK-NEXT: dead $r1 = MOVL_load_indexed $r15, implicit killed $r0

# CHECK-LABEL: name:            far_byte_load
# CHECK-LABEL: body:
# CHECK: $r0 = MOVW_load_pc_island %const.{{[0-9]+}}, -1
# CHECK-NEXT: dead $r2 = MOVB_load_indexed $r15, implicit killed $r0

# CHECK-LABEL: name:            far_word_load
# CHECK-LABEL: body:
# CHECK: $r0 = MOVW_load_pc_island %const.{{[0-9]+}}, -1
# CHECK-NEXT: dead $r3 = MOVW_load_indexed $r15, implicit killed $r0
