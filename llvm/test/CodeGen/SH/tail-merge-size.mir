# RUN: llc -mtriple=sh-unknown-elf -mcpu=sh2 -verify-machineinstrs -run-pass=branch-folder %s -o - | FileCheck %s

--- |
  define i32 @merge_short_tail(i32 %value) optsize { ret i32 %value }
  define i32 @keep_short_tail(i32 %value) { ret i32 %value }
...
---
name:            merge_short_tail
tracksRegLiveness: true
noVRegs:         true
body:             |
  bb.0:
    successors: %bb.1(0x40000000), %bb.2(0x40000000)
    liveins: $r4, $tbit

    BT %bb.2, implicit $tbit

  bb.1:
    liveins: $r4

    $r0 = MOVri 1
    $r0 = ADDri killed $r0, 7
    RTS implicit $pr, implicit $r0

  bb.2:
    liveins: $r4

    $r0 = MOVri 2
    $r0 = ADDri killed $r0, 7
    RTS implicit $pr, implicit $r0
...

# CHECK-LABEL: name:            merge_short_tail
# CHECK: $r0 = MOVri 1
# CHECK: bb.2:
# CHECK: $r0 = ADDri killed $r0, 7
# CHECK-NEXT: RTS implicit $pr, implicit $r0
# CHECK: bb.3:
# CHECK: $r0 = MOVri 2
# CHECK-NEXT: BRA %bb.2

---
name:            keep_short_tail
tracksRegLiveness: true
noVRegs:         true
body:             |
  bb.0:
    successors: %bb.1(0x40000000), %bb.2(0x40000000)
    liveins: $r4, $tbit

    BT %bb.2, implicit $tbit

  bb.1:
    liveins: $r4

    $r0 = MOVri 1
    $r0 = ADDri killed $r0, 7
    RTS implicit $pr, implicit $r0

  bb.2:
    liveins: $r4

    $r0 = MOVri 2
    $r0 = ADDri killed $r0, 7
    RTS implicit $pr, implicit $r0
...

# CHECK-LABEL: name:            keep_short_tail
# CHECK: $r0 = MOVri 1
# CHECK-NEXT: $r0 = ADDri killed $r0, 7
# CHECK-NEXT: RTS implicit $pr, implicit $r0
# CHECK: $r0 = MOVri 2
# CHECK-NEXT: $r0 = ADDri killed $r0, 7
# CHECK-NEXT: RTS implicit $pr, implicit $r0
