# RUN: llc -mtriple=sh-unknown-none-elf -mcpu=sh4 -verify-machineinstrs -run-pass=finalize-isel %t.custom.mir -o %t.custom-be
# RUN: %python %S/Inputs/fpscr-effects.py custom-expanded %t.json %t.custom-be

# Guard the effect contract over generated records, independently classifying
# architectural instructions and checking every status pseudo's replacement.
# This intentionally has no expected opcode count. New members must supply the
# same effects and an expansion witness if they are pseudos.
