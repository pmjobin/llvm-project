# RUN: llc -mtriple=shle-unknown-none-elf -mcpu=sh4 -O2 -run-pass=prolog-epilog -verify-machineinstrs %s -o - | FileCheck %s

--- |
  define void @singleton_load_imm8() { ret void }
  define void @singleton_load_scaled() { ret void }
  define void @singleton_load_max_scaled() { ret void }
  define void @singleton_load_scaled_256() { ret void }
  define void @singleton_store_imm8() { ret void }
  define void @singleton_store_materialized() { ret void }
  define void @live_r0_fallback() { ret void }
  define void @double_fallback() { ret void }
...
---
name: singleton_load_imm8
tracksRegLiveness: true
noVRegs: true
fixedStack:
  - { id: 0, type: default, offset: 120, size: 4, alignment: 4, isImmutable: true }
body: |
  bb.0:
    liveins: $fpscr, $pr

    dead $fr4 = FMOV_S_LOAD_FI %fixed-stack.0, 0, implicit $fpscr :: (load (s32) from %fixed-stack.0)
    RTS implicit $pr
...

# CHECK-LABEL: name:            singleton_load_imm8
# CHECK: $r0 = MOVri 124
# CHECK-NEXT: dead $fr4 = FMOV_S_LOAD_INDEXED_ALIAS $r15, implicit $r0, implicit $fpscr :: (load (s32) from %fixed-stack.0)

---
name: singleton_load_scaled
tracksRegLiveness: true
noVRegs: true
fixedStack:
  - { id: 0, type: default, offset: 124, size: 4, alignment: 4, isImmutable: true }
body: |
  bb.0:
    liveins: $fpscr, $pr

    dead $fr5 = FMOV_S_LOAD_FI %fixed-stack.0, 0, implicit $fpscr :: (load (s32) from %fixed-stack.0)
    RTS implicit $pr
...

# CHECK-LABEL: name:            singleton_load_scaled
# CHECK: $r0 = MOVri 32
# CHECK-NEXT: $r0 = SHLL2 $r0
# CHECK-NEXT: dead $fr5 = FMOV_S_LOAD_INDEXED_ALIAS $r15, implicit $r0, implicit $fpscr :: (load (s32) from %fixed-stack.0)

---
name: singleton_load_max_scaled
tracksRegLiveness: true
noVRegs: true
fixedStack:
  - { id: 0, type: default, offset: 248, size: 4, alignment: 4, isImmutable: true }
body: |
  bb.0:
    liveins: $fpscr, $pr

    dead $fr7 = FMOV_S_LOAD_FI %fixed-stack.0, 0, implicit $fpscr :: (load (s32) from %fixed-stack.0)
    RTS implicit $pr
...

# CHECK-LABEL: name:            singleton_load_max_scaled
# CHECK: $r0 = MOVri 63
# CHECK-NEXT: $r0 = SHLL2 $r0
# CHECK-NEXT: dead $fr7 = FMOV_S_LOAD_INDEXED_ALIAS $r15, implicit $r0, implicit $fpscr :: (load (s32) from %fixed-stack.0)

---
name: singleton_load_scaled_256
tracksRegLiveness: true
noVRegs: true
fixedStack:
  - { id: 0, type: default, offset: 252, size: 4, alignment: 4, isImmutable: true }
body: |
  bb.0:
    liveins: $fpscr, $pr

    dead $fr8 = FMOV_S_LOAD_FI %fixed-stack.0, 0, implicit $fpscr :: (load (s32) from %fixed-stack.0)
    RTS implicit $pr
...

# CHECK-LABEL: name:            singleton_load_scaled_256
# CHECK: $r0 = MOVri 64
# CHECK-NEXT: $r0 = SHLL2 $r0
# CHECK-NEXT: dead $fr8 = FMOV_S_LOAD_INDEXED_ALIAS $r15, implicit $r0, implicit $fpscr :: (load (s32) from %fixed-stack.0)

---
name: singleton_store_imm8
tracksRegLiveness: true
noVRegs: true
fixedStack:
  - { id: 0, type: default, offset: 120, size: 4, alignment: 4, isImmutable: false }
body: |
  bb.0:
    liveins: $fr6, $fpscr, $pr

    FMOV_S_STORE_FI killed $fr6, %fixed-stack.0, 0, implicit $fpscr :: (store (s32) into %fixed-stack.0)
    RTS implicit $pr
...

# CHECK-LABEL: name:            singleton_store_imm8
# CHECK: $r0 = MOVri 124
# CHECK-NEXT: FMOV_S_STORE_INDEXED_ALIAS killed $fr6, $r15, implicit $r0, implicit $fpscr :: (store (s32) into %fixed-stack.0)

---
name: singleton_store_materialized
tracksRegLiveness: true
noVRegs: true
fixedStack:
  - { id: 0, type: default, offset: 508, size: 4, alignment: 4, isImmutable: false }
body: |
  bb.0:
    liveins: $fr7, $fpscr, $pr

    FMOV_S_STORE_FI killed $fr7, %fixed-stack.0, 0, implicit $fpscr :: (store (s32) into %fixed-stack.0)
    RTS implicit $pr
...

# CHECK-LABEL: name:            singleton_store_materialized
# CHECK: $r0 = MOVri 2
# CHECK-NEXT: $r0 = SHLL8 $r0
# CHECK-NEXT: FMOV_S_STORE_INDEXED_ALIAS killed $fr7, $r15, implicit $r0, implicit $fpscr :: (store (s32) into %fixed-stack.0)

---
name: live_r0_fallback
tracksRegLiveness: true
noVRegs: true
fixedStack:
  - { id: 0, type: default, offset: 60, size: 4, alignment: 4, isImmutable: true }
body: |
  bb.0:
    liveins: $r0, $fpscr, $pr

    dead $fr9 = FMOV_S_LOAD_FI %fixed-stack.0, 0, implicit $fpscr :: (load (s32) from %fixed-stack.0)
    TST killed $r0, $r0, implicit-def dead $tbit
    RTS implicit $pr
...

# CHECK-LABEL: name:            live_r0_fallback
# CHECK: $r1 = MOVrr $r15
# CHECK-NEXT: $r1 = ADDri $r1, 64
# CHECK-NEXT: $fr9, dead $r1 = FMOV_S_LOAD_POSTINC_ALIAS killed $r1, implicit $fpscr :: (load (s32) from %fixed-stack.0)
# CHECK-NEXT: TST killed $r0, $r0, implicit-def dead $tbit

---
name: double_fallback
tracksRegLiveness: true
noVRegs: true
fixedStack:
  - { id: 0, type: default, offset: 60, size: 8, alignment: 4, isImmutable: true }
body: |
  bb.0:
    liveins: $fpscr, $pr

    dead $dr4 = FMOV_D_LOAD_FI %fixed-stack.0, 0, implicit $fpscr :: (load (s64) from %fixed-stack.0, align 4)
    RTS implicit $pr
...

# CHECK-LABEL: name:            double_fallback
# CHECK: $r0 = MOVrr $r15
# CHECK-NEXT: $r0 = ADDri $r0, 64
# CHECK-NEXT: $fr5, $r0 = FMOV_S_LOAD_POSTINC_ALIAS killed $r0, implicit $fpscr :: (load (s32) from %fixed-stack.0)
# CHECK-NEXT: $fr4, dead $r0 = FMOV_S_LOAD_POSTINC_ALIAS killed $r0, implicit $fpscr :: (load (s32) from %fixed-stack.0 + 4)
