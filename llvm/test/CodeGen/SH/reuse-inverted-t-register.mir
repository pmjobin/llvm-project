# RUN: llc -mtriple=sh-unknown-elf -mcpu=sh2 -run-pass=peephole-opt -verify-machineinstrs %s -o - | FileCheck %s
# RUN: llc -mtriple=sh-unknown-elf -mcpu=sh1 -run-pass=peephole-opt -verify-machineinstrs %s -o - | FileCheck %s --check-prefix=SH1

--- |
  define i32 @reuse_inverted_t(i32 %value) {
    ret i32 %value
  }

  define i32 @reuse_commuted_inverted_t(i32 %value) {
    ret i32 %value
  }

  define i32 @different_xor_constant(i32 %value) {
    ret i32 %value
  }

  define i32 @intervening_t_clobber(i32 %value) {
    ret i32 %value
  }
...
---
name:            reuse_inverted_t
tracksRegLiveness: true
body:             |
  bb.0:
    successors: %bb.0(0x40000000), %bb.1(0x40000000)
    liveins: $r4

    %0:gpr = COPY $r4
    CMP_EQ %0, %0, implicit-def $tbit
    %1:gpr = MOVT implicit $tbit
    %2:gpr = MOVri 1
    %3:gpr = XORrr %1, %2
    TST %3, %3, implicit-def $tbit
    BT %bb.0, implicit $tbit

  bb.1:
    $r0 = COPY %3
    RTS implicit $pr, implicit $r0
...
---
name:            reuse_commuted_inverted_t
tracksRegLiveness: true
body:             |
  bb.0:
    successors: %bb.0(0x40000000), %bb.1(0x40000000)
    liveins: $r4

    %0:gpr = COPY $r4
    CMP_EQ %0, %0, implicit-def $tbit
    %1:gpr = MOVT implicit $tbit
    %2:gpr = MOVri 1
    %3:gpr = XORrr %2, %1
    TST %3, %3, implicit-def $tbit
    BF %bb.0, implicit $tbit

  bb.1:
    $r0 = COPY %3
    RTS implicit $pr, implicit $r0
...
---
name:            different_xor_constant
tracksRegLiveness: true
body:             |
  bb.0:
    successors: %bb.0(0x40000000), %bb.1(0x40000000)
    liveins: $r4

    %0:gpr = COPY $r4
    CMP_EQ %0, %0, implicit-def $tbit
    %1:gpr = MOVT implicit $tbit
    %2:gpr = MOVri 2
    %3:gpr = XORrr %1, %2
    TST %3, %3, implicit-def $tbit
    BT %bb.0, implicit $tbit

  bb.1:
    $r0 = COPY %3
    RTS implicit $pr, implicit $r0
...
---
name:            intervening_t_clobber
tracksRegLiveness: true
body:             |
  bb.0:
    successors: %bb.0(0x40000000), %bb.1(0x40000000)
    liveins: $r4

    %0:gpr = COPY $r4
    CMP_EQ %0, %0, implicit-def $tbit
    %1:gpr = MOVT implicit $tbit
    %2:gpr = MOVri 1
    %3:gpr = XORrr %1, %2
    CMP_EQ %0, %0, implicit-def $tbit
    TST %3, %3, implicit-def $tbit
    BT %bb.0, implicit $tbit

  bb.1:
    $r0 = COPY %3
    RTS implicit $pr, implicit $r0
...

# CHECK-LABEL: name:            reuse_inverted_t
# CHECK: %3:gpr = XORrr %1, %2
# CHECK-NEXT: BT %bb.0, implicit $tbit
# CHECK-NOT: TST

# CHECK-LABEL: name:            reuse_commuted_inverted_t
# CHECK: %3:gpr = XORrr %2, %1
# CHECK-NEXT: BF %bb.0, implicit $tbit
# CHECK-NOT: TST

# CHECK-LABEL: name:            different_xor_constant
# CHECK: %3:gpr = XORrr %1, %2
# CHECK-NEXT: TST %3, %3, implicit-def $tbit

# CHECK-LABEL: name:            intervening_t_clobber
# CHECK: %3:gpr = XORrr %1, %2
# CHECK-NEXT: CMP_EQ %0, %0, implicit-def $tbit
# CHECK-NEXT: TST %3, %3, implicit-def $tbit

# SH1-LABEL: name:            reuse_inverted_t
# SH1: %3:gpr = XORrr %1, %2
# SH1-NEXT: TST %3, %3, implicit-def $tbit
