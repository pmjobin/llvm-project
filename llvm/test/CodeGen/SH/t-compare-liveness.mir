# RUN: llc -mtriple=sh-unknown-elf -mcpu=sh2 -run-pass=peephole-opt -verify-machineinstrs %s -o - | FileCheck %s
# RUN: llc -mtriple=shle-unknown-elf -mcpu=sh4 -run-pass=peephole-opt -verify-machineinstrs %s -o - | FileCheck %s

# T = (x == y). Comparing MOVT to zero yields !T. A branch inversion
# preserves one decision but cannot change a later MOVT, carry, borrow, or
# branch observation from !T back to T. Comparing to one leaves T unchanged.
--- |
  define i32 @liveout_bt(i32 %x, i32 %y) { ret i32 %x }
  define i32 @liveout_bf(i32 %x, i32 %y) { ret i32 %x }
  define i32 @liveout_bt_s(i32 %x, i32 %y) { ret i32 %x }
  define i32 @liveout_bf_s(i32 %x, i32 %y) { ret i32 %x }
  define i32 @liveout_addc(i32 %x, i32 %y) { ret i32 %x }
  define i32 @liveout_subc(i32 %x, i32 %y) { ret i32 %x }
  define i32 @second_branch(i32 %x, i32 %y) { ret i32 %x }
  define i32 @movt_before_branch(i32 %x, i32 %y) { ret i32 %x }
  define i32 @single_consumer(i32 %x, i32 %y) { ret i32 %x }
  define i32 @untracked(i32 %x, i32 %y) { ret i32 %x }
  define i32 @same_value_liveout(i32 %x, i32 %y) { ret i32 %x }
  define i32 @xor_same_value_liveout(i32 %x, i32 %y) { ret i32 %x }
...
---
name: liveout_bt
tracksRegLiveness: true
body: |
  bb.0:
    successors: %bb.1, %bb.2
    liveins: $r4, $r5
    %0:gpr = COPY $r4
    %1:gpr = COPY $r5
    CMP_EQ %0, %1, implicit-def $tbit
    %2:gpr = MOVT implicit killed $tbit
    TST %2, %2, implicit-def $tbit
    BT %bb.2, implicit $tbit
  bb.1:
    liveins: $tbit
    %3:gpr = MOVT implicit $tbit
    $r0 = COPY %3
    RTS implicit $pr, implicit $r0
  bb.2:
    liveins: $tbit
    %4:gpr = MOVT implicit $tbit
    $r0 = COPY %4
    RTS implicit $pr, implicit $r0
...

# CHECK-LABEL: name:            liveout_bt
# CHECK: TST %2, %2, implicit-def $tbit
# CHECK: BT %bb.2, implicit $tbit

---
name: liveout_bf
tracksRegLiveness: true
body: |
  bb.0:
    successors: %bb.1, %bb.2
    liveins: $r4, $r5
    %0:gpr = COPY $r4
    %1:gpr = COPY $r5
    CMP_EQ %0, %1, implicit-def $tbit
    %2:gpr = MOVT implicit killed $tbit
    TST %2, %2, implicit-def $tbit
    BF %bb.2, implicit $tbit
  bb.1:
    liveins: $tbit
    %3:gpr = MOVT implicit $tbit
    $r0 = COPY %3
    RTS implicit $pr, implicit $r0
  bb.2:
    liveins: $tbit
    %4:gpr = MOVT implicit $tbit
    $r0 = COPY %4
    RTS implicit $pr, implicit $r0
...

# CHECK-LABEL: name:            liveout_bf
# CHECK: TST %2, %2, implicit-def $tbit
# CHECK: BF %bb.2, implicit $tbit

---
name: liveout_bt_s
tracksRegLiveness: true
body: |
  bb.0:
    successors: %bb.1, %bb.2
    liveins: $r4, $r5
    %0:gpr = COPY $r4
    %1:gpr = COPY $r5
    CMP_EQ %0, %1, implicit-def $tbit
    %2:gpr = MOVT implicit killed $tbit
    TST %2, %2, implicit-def $tbit
    BT_S %bb.2, implicit $tbit
  bb.1:
    liveins: $tbit
    %3:gpr = MOVT implicit $tbit
    $r0 = COPY %3
    RTS implicit $pr, implicit $r0
  bb.2:
    liveins: $tbit
    %4:gpr = MOVT implicit $tbit
    $r0 = COPY %4
    RTS implicit $pr, implicit $r0
...

# CHECK-LABEL: name:            liveout_bt_s
# CHECK: TST %2, %2, implicit-def $tbit
# CHECK: BT_S %bb.2, implicit $tbit

---
name: liveout_bf_s
tracksRegLiveness: true
body: |
  bb.0:
    successors: %bb.1, %bb.2
    liveins: $r4, $r5
    %0:gpr = COPY $r4
    %1:gpr = COPY $r5
    CMP_EQ %0, %1, implicit-def $tbit
    %2:gpr = MOVT implicit killed $tbit
    TST %2, %2, implicit-def $tbit
    BF_S %bb.2, implicit $tbit
  bb.1:
    liveins: $tbit
    %3:gpr = MOVT implicit $tbit
    $r0 = COPY %3
    RTS implicit $pr, implicit $r0
  bb.2:
    liveins: $tbit
    %4:gpr = MOVT implicit $tbit
    $r0 = COPY %4
    RTS implicit $pr, implicit $r0
...

# CHECK-LABEL: name:            liveout_bf_s
# CHECK: TST %2, %2, implicit-def $tbit
# CHECK: BF_S %bb.2, implicit $tbit

---
name: liveout_addc
tracksRegLiveness: true
body: |
  bb.0:
    successors: %bb.1, %bb.2
    liveins: $r4, $r5
    %0:gpr = COPY $r4
    %1:gpr = COPY $r5
    CMP_EQ %0, %1, implicit-def $tbit
    %2:gpr = MOVT implicit killed $tbit
    TST %2, %2, implicit-def $tbit
    BT %bb.2, implicit $tbit
  bb.1:
    liveins: $tbit
    %3:gpr = ADDC %0, %1, implicit-def dead $tbit, implicit $tbit
    $r0 = COPY %3
    RTS implicit $pr, implicit $r0
  bb.2:
    liveins: $tbit
    %4:gpr = ADDC %0, %1, implicit-def dead $tbit, implicit $tbit
    $r0 = COPY %4
    RTS implicit $pr, implicit $r0
...

# CHECK-LABEL: name:            liveout_addc
# CHECK: TST %2, %2, implicit-def $tbit
# CHECK: BT %bb.2, implicit $tbit

---
name: liveout_subc
tracksRegLiveness: true
body: |
  bb.0:
    successors: %bb.1, %bb.2
    liveins: $r4, $r5
    %0:gpr = COPY $r4
    %1:gpr = COPY $r5
    CMP_EQ %0, %1, implicit-def $tbit
    %2:gpr = MOVT implicit killed $tbit
    TST %2, %2, implicit-def $tbit
    BT %bb.2, implicit $tbit
  bb.1:
    liveins: $tbit
    %3:gpr = SUBC %0, %1, implicit-def dead $tbit, implicit $tbit
    $r0 = COPY %3
    RTS implicit $pr, implicit $r0
  bb.2:
    liveins: $tbit
    %4:gpr = SUBC %0, %1, implicit-def dead $tbit, implicit $tbit
    $r0 = COPY %4
    RTS implicit $pr, implicit $r0
...

# CHECK-LABEL: name:            liveout_subc
# CHECK: TST %2, %2, implicit-def $tbit
# CHECK: BT %bb.2, implicit $tbit

---
name: second_branch
tracksRegLiveness: true
body: |
  bb.0:
    successors: %bb.1, %bb.2, %bb.3
    liveins: $r4, $r5
    %0:gpr = COPY $r4
    %1:gpr = COPY $r5
    CMP_EQ %0, %1, implicit-def $tbit
    %2:gpr = MOVT implicit killed $tbit
    TST %2, %2, implicit-def $tbit
    BT %bb.2, implicit $tbit
    BT %bb.3, implicit $tbit
    BRA %bb.1
  bb.1:
    %3:gpr = MOVri 10
    $r0 = COPY %3
    RTS implicit $pr, implicit $r0
  bb.2:
    %4:gpr = MOVri 20
    $r0 = COPY %4
    RTS implicit $pr, implicit $r0
  bb.3:
    %5:gpr = MOVri 30
    $r0 = COPY %5
    RTS implicit $pr, implicit $r0
...

# CHECK-LABEL: name:            second_branch
# CHECK: TST %2, %2, implicit-def $tbit
# CHECK: BT %bb.2, implicit $tbit
# CHECK-NEXT: BT %bb.3, implicit $tbit

---
name: movt_before_branch
tracksRegLiveness: true
body: |
  bb.0:
    successors: %bb.1, %bb.2
    liveins: $r4, $r5
    %0:gpr = COPY $r4
    %1:gpr = COPY $r5
    CMP_EQ %0, %1, implicit-def $tbit
    %2:gpr = MOVT implicit killed $tbit
    TST %2, %2, implicit-def $tbit
    %9:gpr = MOVT implicit $tbit
    BT %bb.2, implicit $tbit
  bb.1:
    %3:gpr = COPY %9
    $r0 = COPY %3
    RTS implicit $pr, implicit $r0
  bb.2:
    %4:gpr = COPY %9
    $r0 = COPY %4
    RTS implicit $pr, implicit $r0
...

# CHECK-LABEL: name:            movt_before_branch
# CHECK: TST %2, %2, implicit-def $tbit
# CHECK: BT %bb.2, implicit $tbit

---
name: single_consumer
tracksRegLiveness: true
body: |
  bb.0:
    successors: %bb.1, %bb.2
    liveins: $r4, $r5
    %0:gpr = COPY $r4
    %1:gpr = COPY $r5
    CMP_EQ %0, %1, implicit-def $tbit
    %2:gpr = MOVT implicit killed $tbit
    TST %2, %2, implicit-def $tbit
    BT %bb.2, implicit $tbit
  bb.1:
    %3:gpr = MOVri 10
    $r0 = COPY %3
    RTS implicit $pr, implicit $r0
  bb.2:
    %4:gpr = MOVri 20
    $r0 = COPY %4
    RTS implicit $pr, implicit $r0
...

# CHECK-LABEL: name:            single_consumer
# CHECK: %2:gpr = MOVT implicit $tbit
# CHECK-NOT: TST
# CHECK: BF %bb.2, implicit $tbit

---
name: untracked
tracksRegLiveness: false
body: |
  bb.0:
    successors: %bb.1, %bb.2
    liveins: $r4, $r5
    %0:gpr = COPY $r4
    %1:gpr = COPY $r5
    CMP_EQ %0, %1, implicit-def $tbit
    %2:gpr = MOVT implicit killed $tbit
    TST %2, %2, implicit-def $tbit
    BF %bb.2, implicit $tbit
  bb.1:
    %3:gpr = MOVri 10
    $r0 = COPY %3
    RTS implicit $pr, implicit $r0
  bb.2:
    %4:gpr = MOVri 20
    $r0 = COPY %4
    RTS implicit $pr, implicit $r0
...

# CHECK-LABEL: name:            untracked
# CHECK: TST %2, %2, implicit-def $tbit
# CHECK: BF %bb.2, implicit $tbit

---
name: same_value_liveout
tracksRegLiveness: true
body: |
  bb.0:
    successors: %bb.1, %bb.2
    liveins: $r4, $r5
    %0:gpr = COPY $r4
    %1:gpr = COPY $r5
    CMP_EQ %0, %1, implicit-def $tbit
    %2:gpr = MOVT implicit killed $tbit
    CMP_EQri_VALUE_PSEUDO %2, 1, implicit-def $tbit, implicit-def dead $r0
    BT %bb.2, implicit $tbit
  bb.1:
    liveins: $tbit
    %3:gpr = MOVT implicit $tbit
    $r0 = COPY %3
    RTS implicit $pr, implicit $r0
  bb.2:
    liveins: $tbit
    %4:gpr = MOVT implicit $tbit
    $r0 = COPY %4
    RTS implicit $pr, implicit $r0
...

# CHECK-LABEL: name:            same_value_liveout
# CHECK: %2:gpr = MOVT implicit $tbit
# CHECK-NOT: CMP_EQri_VALUE_PSEUDO
# CHECK: BT %bb.2, implicit $tbit

---
name: xor_same_value_liveout
tracksRegLiveness: true
body: |
  bb.0:
    successors: %bb.1, %bb.2
    liveins: $r4, $r5
    %0:gpr = COPY $r4
    %1:gpr = COPY $r5
    CMP_EQ %0, %1, implicit-def $tbit
    %2:gpr = MOVT implicit killed $tbit
    %7:gpr = MOVri 1
    %8:gpr = XORrr %2, %7
    TST %8, %8, implicit-def $tbit
    BF %bb.2, implicit $tbit
  bb.1:
    liveins: $tbit
    %3:gpr = MOVT implicit $tbit
    $r0 = COPY %3
    RTS implicit $pr, implicit $r0
  bb.2:
    liveins: $tbit
    %4:gpr = MOVT implicit $tbit
    $r0 = COPY %4
    RTS implicit $pr, implicit $r0
...

# CHECK-LABEL: name:            xor_same_value_liveout
# CHECK: %2:gpr = MOVT implicit $tbit
# CHECK-NOT: TST
# CHECK: BF %bb.2, implicit $tbit
