# RUN: not llc -mtriple=sh-unknown-elf -mcpu=sh2 -verify-machineinstrs -start-after=branch-relaxation %s -o /dev/null 2>&1 | FileCheck %s
# RUN: not llc -mtriple=shle-unknown-elf -mcpu=sh2 -verify-machineinstrs -start-after=branch-relaxation %s -o /dev/null 2>&1 | FileCheck %s

# CHECK: LLVM ERROR: SH long branch pseudo is malformed
# CHECK-NOT: assertion

--- |
  define void @malformed_long_branch() { ret void }
...
---
name:            malformed_long_branch
tracksRegLiveness: true
noVRegs:         true
body:             |
  bb.0:
    successors: %bb.1

    dead $r1 = SH_LONG_BRANCH %bb.1, 2, implicit-def $r0

  bb.1:
    RTS implicit $pr
...
