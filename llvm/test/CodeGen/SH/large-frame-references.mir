# RUN: llc -mtriple=sh-unknown-elf -mcpu=sh2 -stack-symbol-ordering=0 -verify-machineinstrs -run-pass=prolog-epilog %s -o - | FileCheck %s
# RUN: llc -mtriple=shle-unknown-elf -mcpu=sh2 -stack-symbol-ordering=0 -verify-machineinstrs -run-pass=prolog-epilog %s -o - | FileCheck %s
# RUN: llc -mtriple=sh-unknown-elf -mcpu=sh2 -stack-symbol-ordering=0 -verify-machineinstrs -run-pass=prolog-epilog %s -o %t.sh.mir
# RUN: llc -mtriple=sh-unknown-elf -mcpu=sh2 -stack-symbol-ordering=0 -verify-machineinstrs -start-after=prolog-epilog -filetype=obj %t.sh.mir -o /dev/null
# RUN: llc -mtriple=shle-unknown-elf -mcpu=sh2 -stack-symbol-ordering=0 -verify-machineinstrs -run-pass=prolog-epilog %s -o %t.shle.mir
# RUN: llc -mtriple=shle-unknown-elf -mcpu=sh2 -stack-symbol-ordering=0 -verify-machineinstrs -start-after=prolog-epilog -filetype=obj %t.shle.mir -o /dev/null

--- |
  define void @large_far_widths() { ret void }
  define i32 @large_incoming(i32 %value) { ret i32 %value }
  define void @large_call_area() { ret void }
  define void @large_call_area_pressure() { ret void }
  define i32 @biased_large_frame_load() { ret i32 0 }
  define void @biased_large_frame_store() { ret void }
  define i32 @indexed_large_frame_load() { ret i32 0 }
  define i32 @indexed_large_frame_load_free_r0() { ret i32 0 }
  define i32 @indexed_large_frame_load_live_r0() { ret i32 0 }
  define void @indexed_large_frame_store() { ret void }
  define void @indexed_large_frame_store_r0() { ret void }
...
---
name: large_far_widths
tracksRegLiveness: true
noVRegs: true
stack:
  - { id: 0, type: default, size: 1, alignment: 1 }
  - { id: 1, type: default, size: 2, alignment: 2 }
  - { id: 2, type: default, size: 8, alignment: 4 }
  - { id: 3, type: default, size: 65516, alignment: 4 }
body: |
  bb.0:
    liveins: $r4, $r5, $r6, $r7

    MOVB_store_frame $r4, %stack.0, 0, implicit-def dead early-clobber $r0 :: (store (s8) into %stack.0)
    MOVW_store_frame $r5, %stack.1, 0, implicit-def dead early-clobber $r0 :: (store (s16) into %stack.1)
    MOVL_store_disp $r6, %stack.2, 0 :: (store (s32) into %stack.2)
    MOVL_store_disp $r7, %stack.2, 4 :: (store (s32) into %stack.2 + 4)
    dead $r0 = MOVB_load_frame %stack.0, 0, implicit-def dead $r0 :: (load (s8) from %stack.0)
    dead $r1 = MOVW_load_frame %stack.1, 0, implicit-def dead $r0 :: (load (s16) from %stack.1)
    dead $r2 = MOVL_load_disp %stack.2, 0 :: (load (s32) from %stack.2)
    dead $r3 = MOVL_load_disp %stack.2, 4 :: (load (s32) from %stack.2 + 4)
    RTS implicit $pr
...
---
name: large_incoming
tracksRegLiveness: true
noVRegs: true
fixedStack:
  - { id: 0, type: default, offset: 4092, size: 4, alignment: 4, isImmutable: true }
stack:
  - { id: 0, type: default, size: 65532, alignment: 4 }
body: |
  bb.0:
    $r0 = MOVL_load_disp %fixed-stack.0, 0 :: (load (s32) from %fixed-stack.0)
    RTS implicit $pr, implicit $r0
...
---
name: large_call_area
tracksRegLiveness: true
noVRegs: true
frameInfo:
  adjustsStack: true
fixedStack:
  - { id: 0, type: default, offset: 0, size: 4, alignment: 4, isImmutable: false }
body: |
  bb.0:
    liveins: $r0

    ADJCALLSTACKDOWN 4096, 0, implicit-def dead $r15, implicit $r15
    MOVL_store_disp $r0, %fixed-stack.0, 0 :: (store (s32) into %fixed-stack.0)
    ADJCALLSTACKUP 4096, 0, implicit-def dead $r15, implicit $r15
    RTS implicit $pr, implicit $r0
...
---
name: large_call_area_pressure
tracksRegLiveness: true
noVRegs: true
frameInfo:
  adjustsStack: true
stack:
  - { id: 0, type: default, size: 4, alignment: 4 }
  - { id: 1, type: default, size: 248, alignment: 4 }
body: |
  bb.0:
    ; r3 is reserved as the materialized large-call adjustment scratch.
    liveins: $r0, $r1, $r2, $r4, $r5, $r6, $r7, $r8, $r9, $r10, $r11, $r12, $r13, $r14

    ADJCALLSTACKDOWN 4096, 0, implicit-def dead $r15, implicit $r15
    MOVL_store_disp $r0, %stack.0, 0 :: (store (s32) into %stack.0)
    ADJCALLSTACKUP 4096, 0, implicit-def dead $r15, implicit $r15
    RTS implicit $pr, implicit $r0, implicit $r1, implicit $r2, implicit $r4, implicit $r5, implicit $r6, implicit $r7, implicit $r8, implicit $r9, implicit $r10, implicit $r11, implicit $r12, implicit $r13, implicit $r14
...

---
name: biased_large_frame_load
tracksRegLiveness: true
noVRegs: true
stack:
  - { id: 0, type: default, size: 4, alignment: 4 }
  - { id: 1, type: default, size: 128, alignment: 4 }
body: |
  bb.0:
    $r0 = MOVL_load_disp %stack.0, 0 :: (load (s32) from %stack.0)
    RTS implicit $pr, implicit $r0
...
---
name: biased_large_frame_store
tracksRegLiveness: true
noVRegs: true
stack:
  - { id: 0, type: default, size: 4, alignment: 4 }
  - { id: 1, type: default, size: 180, alignment: 4 }
body: |
  bb.0:
    liveins: $r4

    MOVL_store_disp $r4, %stack.0, 0 :: (store (s32) into %stack.0)
    RTS implicit $pr
...
---
name: indexed_large_frame_load
tracksRegLiveness: true
noVRegs: true
stack:
  - { id: 0, type: default, size: 4, alignment: 4 }
  - { id: 1, type: default, size: 64, alignment: 4 }
body: |
  bb.0:
    $r0 = MOVL_load_disp %stack.0, 0 :: (load (s32) from %stack.0)
    RTS implicit $pr, implicit $r0
...
---
name: indexed_large_frame_load_free_r0
tracksRegLiveness: true
noVRegs: true
stack:
  - { id: 0, type: default, size: 4, alignment: 4 }
  - { id: 1, type: default, size: 64, alignment: 4 }
body: |
  bb.0:
    $r1 = MOVL_load_disp %stack.0, 0 :: (load (s32) from %stack.0)
    RTS implicit $pr, implicit $r1
...
---
name: indexed_large_frame_load_live_r0
tracksRegLiveness: true
noVRegs: true
stack:
  - { id: 0, type: default, size: 4, alignment: 4 }
  - { id: 1, type: default, size: 64, alignment: 4 }
body: |
  bb.0:
    liveins: $r0

    $r1 = MOVL_load_disp %stack.0, 0 :: (load (s32) from %stack.0)
    RTS implicit $pr, implicit $r0, implicit $r1
...
---
name: indexed_large_frame_store
tracksRegLiveness: true
noVRegs: true
stack:
  - { id: 0, type: default, size: 4, alignment: 4 }
  - { id: 1, type: default, size: 60, alignment: 4 }
body: |
  bb.0:
    liveins: $r4

    MOVL_store_disp $r4, %stack.0, 0 :: (store (s32) into %stack.0)
    RTS implicit $pr
...
---
name: indexed_large_frame_store_r0
tracksRegLiveness: true
noVRegs: true
stack:
  - { id: 0, type: default, size: 4, alignment: 4 }
  - { id: 1, type: default, size: 60, alignment: 4 }
body: |
  bb.0:
    liveins: $r0

    MOVL_store_disp $r0, %stack.0, 0 :: (store (s32) into %stack.0)
    RTS implicit $pr
...

# CHECK-LABEL: name:            large_far_widths
# CHECK: stackSize:       65532
# CHECK-LABEL: body:
# CHECK-NOT: %stack.
# CHECK: MOVB_store_indexed $r4, $r15, implicit killed $r0
# CHECK: MOVW_store_indexed $r5, $r15, implicit killed $r0
# CHECK: MOVL_store_indexed $r6, $r15, implicit killed $r0
# CHECK: MOVL_store_indexed $r7, $r15, implicit killed $r0
# CHECK: dead $r0 = MOVB_load_indexed $r15, implicit killed $r0
# CHECK: dead $r1 = MOVW_load_indexed $r15, implicit killed $r0
# CHECK: dead $r2 = MOVL_load_indexed $r15, implicit killed $r0
# CHECK: dead $r3 = MOVL_load_indexed $r15, implicit killed $r0

# CHECK-LABEL: name:            large_incoming
# CHECK: stackSize:       65532
# CHECK-LABEL: body:
# CHECK-NOT: %fixed-stack.
# CHECK: $r0 = MOVri 1
# CHECK: $r0 = MOVL_load_indexed $r15, implicit killed $r0

# CHECK-LABEL: name:            large_call_area
# CHECK: stackSize:       4
# CHECK-LABEL: body:
# CHECK: $r3 = MOVri 16
# CHECK-NEXT: $r3 = SHLL8 $r3
# CHECK-NEXT: $r15 = SUBrr $r15, killed $r3
# CHECK: MOVL_store_reg $r0, killed ${{r[0-9]+}}
# CHECK: $r3 = MOVri 16
# CHECK-NEXT: $r3 = SHLL8 $r3
# CHECK-NEXT: $r15 = ADDrr $r15, killed $r3

# CHECK-LABEL: name:            large_call_area_pressure
# CHECK: stackSize:       256
# CHECK-LABEL: body:
# CHECK: $r15 = frame-setup ADDri $r15, -128
# CHECK: MOVL_store_disp killed ${{r[0-9]+}}, $r15, 60
# CHECK: MOVL_store_reg $r0, killed ${{r[0-9]+}}
# CHECK: ${{r[0-9]+}} = MOVL_load_reg ${{r[0-9]+}}
# CHECK: $r3 = MOVri 16
# CHECK-NEXT: $r3 = SHLL8 $r3
# CHECK-NEXT: $r15 = ADDrr $r15, killed $r3

# CHECK-LABEL: name:            biased_large_frame_load
# CHECK: stackSize:       132
# CHECK-LABEL: body:
# CHECK: $r0 = MOVrr $r15
# CHECK-NEXT: $r0 = ADDri $r0, 68
# CHECK-NEXT: $r0 = MOVL_load_disp $r0, 60

# CHECK-LABEL: name:            biased_large_frame_store
# CHECK: stackSize:       188
# CHECK-LABEL: body:
# CHECK: [[ADDRESS:\$r[0-9]+]] = MOVrr $r15
# CHECK-NEXT: [[ADDRESS]] = ADDri [[ADDRESS]], 124
# CHECK-NEXT: MOVL_store_disp $r4, killed [[ADDRESS]], 60

# CHECK-LABEL: name:            indexed_large_frame_load
# CHECK: stackSize:       68
# CHECK-LABEL: body:
# CHECK: $r0 = MOVri 64
# CHECK-NEXT: $r0 = MOVL_load_indexed $r15, implicit killed $r0

# CHECK-LABEL: name:            indexed_large_frame_load_free_r0
# CHECK-LABEL: body:
# CHECK: $r0 = MOVri 64
# CHECK-NEXT: $r1 = MOVL_load_indexed $r15, implicit killed $r0

# CHECK-LABEL: name:            indexed_large_frame_load_live_r0
# CHECK-LABEL: body:
# CHECK: $r1 = MOVrr $r15
# CHECK-NEXT: $r1 = ADDri $r1, 64
# CHECK-NEXT: $r1 = MOVL_load_reg $r1

# CHECK-LABEL: name:            indexed_large_frame_store
# CHECK: stackSize:       68
# CHECK-LABEL: body:
# CHECK: $r0 = MOVri 64
# CHECK-NEXT: MOVL_store_indexed $r4, $r15, implicit killed $r0

# CHECK-LABEL: name:            indexed_large_frame_store_r0
# CHECK-LABEL: body:
# CHECK-NOT: MOVL_store_indexed
# CHECK: MOVL_store_reg $r0, killed ${{r[1-9][0-9]*}}
