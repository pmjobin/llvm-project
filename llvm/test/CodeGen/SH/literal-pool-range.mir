#--- unassigned.mir
--- |
  define i32 @unassigned() {
    ret i32 0
  }
...
---
name:            unassigned
alignment:       4
tracksRegLiveness: true
noVRegs:         true
constants:
  - id:          0
    value:       'i32 42'
    alignment:   4
body:             |
  bb.0:
    $r0 = MOVL_load_pc_island %const.0, -1 :: (dereferenceable invariant load (s32) from constant-pool)
    RTS implicit $pr, implicit $r0 {
