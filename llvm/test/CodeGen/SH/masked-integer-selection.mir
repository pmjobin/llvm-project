body: |
  bb.0:
    liveins: $r0, $r4

    $r1 = MOVri 7
    $r0 = MOVB_load_reg $r4 :: (load (s8) from %ir.p)
    $r0 = EXTUB $r0
    $r0 = ANDrr $r0, $r1
...

# CHECK-LABEL: name: byte_window
# CHECK: MOV{{[BW]}}_load_reg{{.*}} :: (load
# CHECK: $r0 = EXTUB $r0
# CHECK: ANDrr

