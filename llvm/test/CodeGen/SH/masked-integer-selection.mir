---
name: fault_boundary
alignment: 4
tracksRegLiveness: true
noVRegs: true
body: |
  bb.0:
    liveins: $r0, $r4
    $r1 = MOVri 7
    $r0 = MOVB_load_reg $r4 :: (load (s8) from %ir.p)
    $r0 = EXTUB $r0
    $r2 = MOVL_load_reg $r4 :: (load (s32) from %ir.p)
    $r0 = ANDrr $r0, $r1
...
# CHECK-LABEL: name: fault_boundary
# CHECK: $r0 = EXTUB $r0
# CHECK-NEXT: $r2 = MOVL_load_reg
# CHECK-NEXT: $r0 = ANDrr
---
