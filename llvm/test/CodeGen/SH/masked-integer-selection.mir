# RUN: llc -mtriple=shle-unknown-elf -mcpu=sh2 -O3 -verify-machineinstrs -run-pass=sh-delay-slot-filler %s -o - | FileCheck %s
# RUN: llc -mtriple=sh-unknown-elf -mcpu=sh4 -O3 -verify-machineinstrs -run-pass=sh-delay-slot-filler %s -o - | FileCheck %s

# The late masked rewrite is omitted; preserve ordinary producer instructions.
# The mask and every physical operand/memory contract remain explicit.
--- |
  define void @shift_window(ptr %p)  { ret void }
  define void @shift_upper_window(ptr %p)  { ret void }
  define void @left_window(ptr %p)  { ret void }
  define void @word_window(ptr %p)  { ret void }
  define void @byte_window(ptr %p)  { ret void }
  define void @signed_window(ptr %p)  { ret void }
  define void @shared_shift(ptr %p)  { ret void }
  define void @shared_extension(ptr %p)  { ret void }
  define void @r0_copy_tie(ptr %p)  { ret void }
  define void @noncontiguous(ptr %p)  { ret void }
  define void @zero(ptr %p)  { ret void }
  define void @full(ptr %p)  { ret void }
  define void @sign_touching(ptr %p)  { ret void }
  define void @volatile_load(ptr %p)  { ret void }
  define void @wide_demand(ptr %p)  { ret void }
  define void @shift_tie(ptr %p)  { ret void }
  define void @one_bit_T(ptr %p)  { ret void }
  define void @size(ptr %p) optsize { ret void }
  define void @minsize(ptr %p) minsize { ret void }
  define void @optnone(ptr %p) optnone noinline { ret void }
  define void @fault_boundary(ptr %p) { ret void }
  define void @atomic_load(ptr %p) { ret void }
...
---
name: shift_window
alignment: 4
tracksRegLiveness: true
noVRegs: true
body: |
  bb.0:
    liveins: $r0, $r4

    $r1 = MOVri 60
    $r0 = SHLR2 $r0
    $r2 = MOVri 11
    $r0 = SHLR2 $r0
    $r0 = SHLR2 $r0
    $r0 = ANDrr $r0, $r1
...

# CHECK-LABEL: name: shift_window
# CHECK-COUNT-3: $r0 = SHLR2 $r0
# CHECK: $r0 = ANDrr

---
name: shift_upper_window
alignment: 4
tracksRegLiveness: true
noVRegs: true
body: |
  bb.0:
    liveins: $r0, $r4

    $r1 = MOVri 1020
    $r0 = SHLR8 $r0
    $r0 = SHLR2 $r0
    $r0 = SHLR2 $r0
    $r0 = SHLR2 $r0
    $r0 = ANDrr $r0, $r1
...

# CHECK-LABEL: name: shift_upper_window
# CHECK: $r0 = SHLR8 $r0
# CHECK-COUNT-3: $r0 = SHLR2 $r0
# CHECK: $r0 = ANDrr

---
name: left_window
alignment: 4
tracksRegLiveness: true
noVRegs: true
body: |
  bb.0:
    liveins: $r0, $r4

    $r1 = MOVri 3840
    $r0 = SHLL2 $r0
    $r0 = SHLL2 $r0
    $r0 = SHLL2 $r0
    $r0 = ANDrr $r0, $r1
...

# CHECK-LABEL: name: left_window
# CHECK-COUNT-3: $r0 = SHLL2 $r0
# CHECK: $r0 = ANDrr

---
name: word_window
alignment: 4
tracksRegLiveness: true
noVRegs: true
body: |
  bb.0:
    liveins: $r0, $r4

    $r1 = MOVri 31
    $r0 = MOVW_load_reg $r4 :: (load (s16) from %ir.p)
    $r0 = EXTUW $r0
    $r0 = ANDrr $r0, $r1
...

# CHECK-LABEL: name: word_window
# CHECK: MOV{{[BW]}}_load_reg{{.*}} :: (load
# CHECK: $r0 = EXTUW $r0
# CHECK: ANDrr

---
name: byte_window
alignment: 4
tracksRegLiveness: true
