    $r1 = MOVri 30720
    $r0 = MOVW_load_reg $r4 :: (load (s16) from %ir.p)
    $r0 = EXTSW $r0
    $r0 = ANDrr $r0, $r1
...

# CHECK-LABEL: name: signed_window
# CHECK: MOV{{[BW]}}_load_reg{{.*}} :: (load
# CHECK: $r0 = EXTSW $r0
# CHECK: ANDrr

