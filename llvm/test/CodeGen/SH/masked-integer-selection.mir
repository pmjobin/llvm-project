tracksRegLiveness: true
noVRegs: true
body: |
  bb.0:
    liveins: $r0, $r4
    $r1 = MOVri 7
    $r0 = MOVB_load_reg $r4 :: (load monotonic (s8) from %ir.p)
    $r0 = EXTUB $r0
    $r0 = ANDrr $r0, $r1
...
# CHECK-LABEL: name: atomic_load
# CHECK: load monotonic (s8)
# CHECK-NEXT: $r0 = EXTUB $r0
# CHECK-NEXT: $r0 = ANDrr
