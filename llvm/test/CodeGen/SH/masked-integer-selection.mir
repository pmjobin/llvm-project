noVRegs: true
body: |
  bb.0:
    liveins: $r0, $r4

    $r1 = MOVri 60
    $r0 = SHLR2 $r0
    $r0 = SHLR2 $r0
    $r0 = SHLR2 $r0
    $r2 = MOVrr $r0
    $r0 = ANDrr $r0, $r1
...

# CHECK-LABEL: name: shared_shift
# CHECK: ANDrr

