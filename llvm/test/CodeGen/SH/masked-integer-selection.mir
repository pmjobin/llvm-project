---
name: one_bit_T
alignment: 4
tracksRegLiveness: true
noVRegs: true
body: |
  bb.0:
    liveins: $r0, $r4

    $r1 = MOVri 60
    $r0 = SHLR2 $r0
    $r0 = SHLR2 $r0
    $r0 = SHLR $r0, implicit-def $tbit
    $r2 = MOVT implicit $tbit
    $r0 = ANDrr $r0, $r1
...

# CHECK-LABEL: name: one_bit_T
# CHECK: $r0 = SHLR $r0, implicit-def $tbit
# CHECK: $r2 = MOVT implicit $tbit
# CHECK: ANDrr

