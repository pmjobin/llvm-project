# RUN: split-file %s %t
# RUN: llc -mtriple=sh-unknown-elf -mcpu=sh2 -verify-machineinstrs -run-pass=prolog-epilog %t/byte-sixteen.mir -o - | FileCheck %s --check-prefix=BYTE
# RUN: llc -mtriple=sh-unknown-elf -mcpu=sh2 -verify-machineinstrs -run-pass=prolog-epilog %t/word-thirty-two.mir -o - | FileCheck %s --check-prefix=WORD
# RUN: llc -mtriple=sh-unknown-elf -mcpu=sh2 -verify-machineinstrs -run-pass=prolog-epilog %t/byte-store-sixteen.mir -o - | FileCheck %s --check-prefix=BYTE-STORE
# RUN: llc -mtriple=sh-unknown-elf -mcpu=sh2 -verify-machineinstrs -run-pass=prolog-epilog %t/word-store-thirty-two.mir -o - | FileCheck %s --check-prefix=WORD-STORE
# RUN: llc -mtriple=sh-unknown-elf -mcpu=sh2 -verify-machineinstrs -run-pass=prolog-epilog %t/byte-store-r0.mir -o - | FileCheck %s --check-prefix=BYTE-STORE-R0
# RUN: llc -mtriple=sh-unknown-elf -mcpu=sh2 -verify-machineinstrs -run-pass=prolog-epilog %t/long-seventy-six.mir -o - | FileCheck %s --check-prefix=LONG
# RUN: not llc -mtriple=sh-unknown-elf -mcpu=sh2 -verify-machineinstrs -run-pass=prolog-epilog %t/word-odd.mir -o /dev/null 2>&1 | FileCheck %s --check-prefix=ODD
# RUN: llc -mtriple=shle-unknown-elf -mcpu=sh2 -verify-machineinstrs -run-pass=prolog-epilog %t/byte-sixteen.mir -o - | FileCheck %s --check-prefix=BYTE
# RUN: llc -mtriple=shle-unknown-elf -mcpu=sh2 -verify-machineinstrs -run-pass=prolog-epilog %t/word-thirty-two.mir -o - | FileCheck %s --check-prefix=WORD
# RUN: llc -mtriple=shle-unknown-elf -mcpu=sh2 -verify-machineinstrs -run-pass=prolog-epilog %t/byte-store-sixteen.mir -o - | FileCheck %s --check-prefix=BYTE-STORE
# RUN: llc -mtriple=shle-unknown-elf -mcpu=sh2 -verify-machineinstrs -run-pass=prolog-epilog %t/word-store-thirty-two.mir -o - | FileCheck %s --check-prefix=WORD-STORE
# RUN: llc -mtriple=shle-unknown-elf -mcpu=sh2 -verify-machineinstrs -run-pass=prolog-epilog %t/byte-store-r0.mir -o - | FileCheck %s --check-prefix=BYTE-STORE-R0

# BYTE: $r0 = MOVri 16
# BYTE-NEXT: dead $r1 = MOVB_load_indexed $r15, implicit killed $r0
# WORD: $r0 = MOVri 32
# WORD-NEXT: dead $r1 = MOVW_load_indexed $r15, implicit killed $r0
# BYTE-STORE: $r0 = MOVri 16
# BYTE-STORE-NEXT: MOVB_store_indexed killed $r1, $r15, implicit killed $r0
# WORD-STORE: $r0 = MOVri 32
# WORD-STORE-NEXT: MOVW_store_indexed killed $r2, $r15, implicit killed $r0
# BYTE-STORE-R0: [[ADDRESS:\$r[1-9][0-9]*]] = MOVrr $r15
# BYTE-STORE-R0-NEXT: [[ADDRESS]] = ADDri [[ADDRESS]], 16
# BYTE-STORE-R0-NEXT: MOVB_store_reg killed $r0, killed [[ADDRESS]]
# LONG: $r0 = MOVri 76
# LONG-NEXT: dead $r1 = MOVL_load_indexed $r15, implicit killed $r0
# ODD: LLVM ERROR: SH finalized word frame reference offset 29 must be even and in [0, 30] from r15

#--- byte-sixteen.mir
--- |
  define void @byte_sixteen() {
    ret void
  }
...
---
name:            byte_sixteen
tracksRegLiveness: true
noVRegs:         true
frameInfo:
  adjustsStack:    true
fixedStack:
  - { id: 0, type: default, offset: 4, size: 1, alignment: 1, stack-id: default,
      isImmutable: true, isAliased: false }
body:             |
  bb.0:
    ADJCALLSTACKDOWN 12, 0, implicit-def dead $r15, implicit $r15
    dead $r1 = MOVB_load_frame %fixed-stack.0, 0, implicit-def dead $r0 :: (load (s8) from %fixed-stack.0)
    ADJCALLSTACKUP 12, 0, implicit-def dead $r15, implicit $r15
    RTS implicit $pr
...

#--- word-thirty-two.mir
--- |
  define void @word_thirty_two() {
    ret void
  }
...
---
name:            word_thirty_two
tracksRegLiveness: true
noVRegs:         true
frameInfo:
  adjustsStack:    true
fixedStack:
  - { id: 0, type: default, offset: 20, size: 2, alignment: 2, stack-id: default,
      isImmutable: true, isAliased: false }
body:             |
  bb.0:
    ADJCALLSTACKDOWN 12, 0, implicit-def dead $r15, implicit $r15
    dead $r1 = MOVW_load_frame %fixed-stack.0, 0, implicit-def dead $r0 :: (load (s16) from %fixed-stack.0)
    ADJCALLSTACKUP 12, 0, implicit-def dead $r15, implicit $r15
    RTS implicit $pr
...

#--- byte-store-sixteen.mir
--- |
  define void @byte_store_sixteen() {
    ret void
  }
...
---
name:            byte_store_sixteen
tracksRegLiveness: true
noVRegs:         true
frameInfo:
  adjustsStack:    true
fixedStack:
  - { id: 0, type: default, offset: 4, size: 1, alignment: 1, stack-id: default,
      isImmutable: false, isAliased: false }
body:             |
  bb.0:
    liveins: $r1

    ADJCALLSTACKDOWN 12, 0, implicit-def dead $r15, implicit $r15
    MOVB_store_frame killed $r1, %fixed-stack.0, 0, implicit-def dead early-clobber $r0 :: (store (s8) into %fixed-stack.0)
    ADJCALLSTACKUP 12, 0, implicit-def dead $r15, implicit $r15
    RTS implicit $pr
...

#--- word-store-thirty-two.mir
--- |
  define void @word_store_thirty_two() {
    ret void
  }
...
---
name:            word_store_thirty_two
tracksRegLiveness: true
noVRegs:         true
frameInfo:
  adjustsStack:    true
fixedStack:
  - { id: 0, type: default, offset: 20, size: 2, alignment: 2, stack-id: default,
      isImmutable: false, isAliased: false }
body:             |
  bb.0:
    liveins: $r2

    ADJCALLSTACKDOWN 12, 0, implicit-def dead $r15, implicit $r15
    MOVW_store_frame killed $r2, %fixed-stack.0, 0, implicit-def dead early-clobber $r0 :: (store (s16) into %fixed-stack.0)
    ADJCALLSTACKUP 12, 0, implicit-def dead $r15, implicit $r15
    RTS implicit $pr
...

#--- byte-store-r0.mir
--- |
  define void @byte_store_r0() {
    ret void
  }
...
---
name:            byte_store_r0
tracksRegLiveness: true
noVRegs:         true
frameInfo:
  adjustsStack:    true
fixedStack:
  - { id: 0, type: default, offset: 4, size: 1, alignment: 1, stack-id: default,
      isImmutable: false, isAliased: false }
body:             |
  bb.0:
    liveins: $r0

    ADJCALLSTACKDOWN 12, 0, implicit-def dead $r15, implicit $r15
    MOVB_store_frame killed $r0, %fixed-stack.0, 0, implicit-def dead early-clobber $r0 :: (store (s8) into %fixed-stack.0)
    ADJCALLSTACKUP 12, 0, implicit-def dead $r15, implicit $r15
    RTS implicit $pr
...

#--- long-seventy-six.mir
--- |
  define void @long_seventy_six() {
    ret void
  }
...
---
name:            long_seventy_six
tracksRegLiveness: true
noVRegs:         true
frameInfo:
  adjustsStack:    true
fixedStack:
  - { id: 0, type: default, offset: 16, size: 4, alignment: 4, stack-id: default,
      isImmutable: true, isAliased: false }
body:             |
  bb.0:
    ADJCALLSTACKDOWN 60, 0, implicit-def dead $r15, implicit $r15
    dead $r1 = MOVL_load_disp %fixed-stack.0, 0 :: (load (s32) from %fixed-stack.0)
    ADJCALLSTACKUP 60, 0, implicit-def dead $r15, implicit $r15
    RTS implicit $pr
...

#--- word-odd.mir
--- |
  define void @word_odd() {
    ret void
  }
...
---
name:            word_odd
tracksRegLiveness: true
noVRegs:         true
frameInfo:
  adjustsStack:    true
fixedStack:
  - { id: 0, type: default, offset: 17, size: 2, alignment: 1, stack-id: default,
      isImmutable: true, isAliased: false }
body:             |
  bb.0:
    ADJCALLSTACKDOWN 12, 0, implicit-def dead $r15, implicit $r15
    dead $r1 = MOVW_load_frame %fixed-stack.0, 0, implicit-def dead $r0 :: (load (s16) from %fixed-stack.0)
    ADJCALLSTACKUP 12, 0, implicit-def dead $r15, implicit $r15
    RTS implicit $pr
...
