# RUN: llc -mtriple=sh-unknown-elf -mcpu=sh2 -verify-machineinstrs -run-pass=sh-postra-peephole %s -o - | FileCheck %s
# RUN: llc -mtriple=shle-unknown-elf -mcpu=sh4 -verify-machineinstrs -run-pass=sh-postra-peephole %s -o - | FileCheck %s

# The materialized value is also the implicit R0 input of an immediate logic
# instruction. Removing it would read the incoming, undefined value of R0.
--- |
  define i32 @self_and() { ret i32 5 }
  define i32 @self_or() { ret i32 5 }
  define i32 @self_xor() { ret i32 0 }
...
---
name: self_and
tracksRegLiveness: true
noVRegs: true
body: |
  bb.0:
    liveins: $pr
    $r0 = MOVri 5
    $r0 = ANDrr $r0, killed $r0
    RTS implicit $pr, implicit $r0
...

# CHECK-LABEL: name: self_and
# CHECK: $r0 = MOVri 5
# CHECK-NEXT: $r0 = ANDrr $r0, killed $r0

---
name: self_or
tracksRegLiveness: true
noVRegs: true
body: |
  bb.0:
    liveins: $pr
    $r0 = MOVri 5
    $r0 = ORrr $r0, killed $r0
    RTS implicit $pr, implicit $r0
...

# CHECK-LABEL: name: self_or
# CHECK: $r0 = MOVri 5
# CHECK-NEXT: $r0 = ORrr $r0, killed $r0

---
name: self_xor
tracksRegLiveness: true
noVRegs: true
body: |
  bb.0:
    liveins: $pr
    $r0 = MOVri 5
    $r0 = XORrr $r0, killed $r0
    RTS implicit $pr, implicit $r0
...

# CHECK-LABEL: name: self_xor
# CHECK: $r0 = MOVri 5
# CHECK-NEXT: $r0 = XORrr $r0, killed $r0
