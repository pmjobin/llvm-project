# NOTE: Assertions have been autogenerated by utils/update_mir_test_checks.py UTC_ARGS: --version 6
# Native redundancy tracking crosses independent instructions and repairs
# kills while retaining live copy results. No target-local adjacency scan.
# RUN: llc -mtriple=sh-unknown-elf -mcpu=sh2 -verify-machineinstrs -run-pass=machine-cp -mcp-use-is-copy-instr %s -o - | FileCheck %s
# RUN: llc -mtriple=shle-unknown-elf -mcpu=sh4 -verify-machineinstrs -run-pass=machine-cp -mcp-use-is-copy-instr %s -o - | FileCheck %s

--- |
  define void @fold_live_roundtrip() { ret void }
  define void @repair_kill_flags() { ret void }
  define void @fold_nonadjacent_roundtrip() { ret void }
  define void @keep_different_copy() { ret void }
...
---
name:            fold_live_roundtrip
tracksRegLiveness: true
noVRegs:         true
body:             |
  bb.0:
    liveins: $r0, $pr

    ; CHECK-LABEL: name: fold_live_roundtrip
    ; CHECK: liveins: $r0, $pr
    ; CHECK-NEXT: {{  $}}
    ; CHECK-NEXT: $r1 = MOVrr $r0
    ; CHECK-NEXT: CMP_EQri 35, implicit-def dead $tbit, implicit $r0
    ; CHECK-NEXT: $r2 = MOVrr killed $r1
    ; CHECK-NEXT: RTS implicit $pr, implicit killed $r0, implicit $r2
    $r1 = MOVrr $r0
    $r0 = MOVrr $r1
    CMP_EQri 35, implicit-def dead $tbit, implicit $r0
    $r2 = MOVrr killed $r1
    RTS implicit $pr, implicit killed $r0, implicit $r2
...


---
name:            repair_kill_flags
tracksRegLiveness: true
noVRegs:         true
body:             |
  bb.0:
    liveins: $r0, $pr

    ; CHECK-LABEL: name: repair_kill_flags
    ; CHECK: liveins: $r0, $pr
    ; CHECK-NEXT: {{  $}}
    ; CHECK-NEXT: RTS implicit $pr, implicit killed $r0
    $r1 = MOVrr killed $r0
    $r0 = MOVrr killed $r1
    RTS implicit $pr, implicit killed $r0
...


---
name:            fold_nonadjacent_roundtrip
tracksRegLiveness: true
noVRegs:         true
body:             |
  bb.0:
    liveins: $r0, $pr

    ; CHECK-LABEL: name: fold_nonadjacent_roundtrip
    ; CHECK: liveins: $r0, $pr
    ; CHECK-NEXT: {{  $}}
    ; CHECK-NEXT: NOP
    ; CHECK-NEXT: RTS implicit $pr, implicit $r0
    $r1 = MOVrr killed $r0
    NOP
    $r0 = MOVrr killed $r1
    RTS implicit $pr, implicit $r0
...


---
name:            keep_different_copy
tracksRegLiveness: true
noVRegs:         true
body:             |
  bb.0:
    liveins: $r0, $pr

    ; CHECK-LABEL: name: keep_different_copy
    ; CHECK: liveins: $r0, $pr
    ; CHECK-NEXT: {{  $}}
    ; CHECK-NEXT: $r1 = MOVrr killed $r0
    ; CHECK-NEXT: $r2 = MOVrr killed $r1
    ; CHECK-NEXT: RTS implicit $pr, implicit $r2
    $r1 = MOVrr killed $r0
    $r2 = MOVrr killed $r1
    RTS implicit $pr, implicit $r2
...
