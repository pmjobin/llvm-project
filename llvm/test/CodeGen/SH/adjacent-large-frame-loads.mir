# RUN: llc -mtriple=shle-unknown-none-elf -mcpu=sh2 -O2 -run-pass=prolog-epilog -verify-machineinstrs %s -o - | FileCheck %s

--- |
  define void @adjacent_large_frame_loads() { ret void }
...
---
name: adjacent_large_frame_loads
tracksRegLiveness: true
noVRegs: true
fixedStack:
  - { id: 0, type: default, offset: 64, size: 4, alignment: 4, isImmutable: true }
  - { id: 1, type: default, offset: 68, size: 4, alignment: 4, isImmutable: true }
  - { id: 2, type: default, offset: 72, size: 4, alignment: 4, isImmutable: true }
body: |
  bb.0:
    dead $r1 = MOVL_load_disp %fixed-stack.0, 0 :: (load (s32) from %fixed-stack.0)
    dead $r2 = MOVL_load_disp %fixed-stack.1, 0 :: (load (s32) from %fixed-stack.1)
    dead $r3 = MOVL_load_disp %fixed-stack.2, 0 :: (load (s32) from %fixed-stack.2)
    RTS implicit $pr
...

# CHECK: [[ADDRESS:\$r[0-9]+]] = MOVrr $r15
# CHECK-NEXT: [[ADDRESS]] = ADDri [[ADDRESS]], 64
# CHECK-NEXT: dead early-clobber $r1, [[ADDRESS]] = MOVL_load_postinc killed [[ADDRESS]]
# CHECK-NEXT: dead early-clobber $r2, [[ADDRESS]] = MOVL_load_postinc killed [[ADDRESS]]
# CHECK-NEXT: dead $r3 = MOVL_load_reg killed [[ADDRESS]]
