# RUN: llc -mtriple=sh-unknown-elf -mcpu=sh2 -verify-machineinstrs -run-pass=sh-postra-peephole %s -o - | FileCheck %s
# RUN: llc -mtriple=shle-unknown-elf -mcpu=sh4 -verify-machineinstrs -run-pass=sh-postra-peephole %s -o - | FileCheck %s

--- |
  define void @fold_direct_r0_byte_load(ptr %p) { ret void }
  define void @fold_direct_r0_word_load(ptr %p) { ret void }
  define void @keep_direct_non_r0_load(ptr %p) { ret void }
  define void @keep_direct_r0_large_byte_load(ptr %p) { ret void }
...
---
name:            fold_direct_r0_byte_load
tracksRegLiveness: true
noVRegs:         true
body:             |
  bb.0:
    liveins: $r0

    $r0 = ADDri $r0, 15
    $r0 = MOVB_load_reg killed $r0 :: (load (s8) from %ir.p)
    RTS implicit $pr, implicit $r0
...

# CHECK-LABEL: name:            fold_direct_r0_byte_load
# CHECK-NOT: ADDri
# CHECK: $r0 = MOVB_load_disp $r0, 15

---
name:            fold_direct_r0_word_load
tracksRegLiveness: true
noVRegs:         true
body:             |
  bb.0:
    liveins: $r0

    $r0 = ADDri $r0, 30
    dead $r0 = MOVW_load_reg killed $r0 :: (load (s16) from %ir.p)
    RTS implicit $pr
...

# CHECK-LABEL: name:            fold_direct_r0_word_load
# CHECK-NOT: ADDri
# CHECK: dead $r0 = MOVW_load_disp $r0, 30

---
name:            keep_direct_non_r0_load
tracksRegLiveness: true
noVRegs:         true
body:             |
  bb.0:
    liveins: $r0

    $r0 = ADDri $r0, 4
    $r2 = MOVB_load_reg killed $r0 :: (load (s8) from %ir.p)
    RTS implicit $pr, implicit $r2
...

# CHECK-LABEL: name:            keep_direct_non_r0_load
# CHECK: $r0 = ADDri $r0, 4
# CHECK-NEXT: $r2 = MOVB_load_reg killed $r0

---
name:            keep_direct_r0_large_byte_load
tracksRegLiveness: true
noVRegs:         true
body:             |
  bb.0:
    liveins: $r0

    $r0 = ADDri $r0, 16
    $r0 = MOVB_load_reg killed $r0 :: (load (s8) from %ir.p)
    RTS implicit $pr, implicit $r0
...

# CHECK-LABEL: name:            keep_direct_r0_large_byte_load
# CHECK: $r0 = ADDri $r0, 16
# CHECK-NEXT: $r0 = MOVB_load_reg killed $r0
