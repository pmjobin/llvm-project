# RUN: llc -mtriple=shle-unknown-elf -mcpu=sh4 -verify-machineinstrs -run-pass=machine-cp -mcp-use-is-copy-instr %s -o - | FileCheck %s
# RUN: llc -mtriple=sh-unknown-elf -mcpu=sh2 -verify-machineinstrs -run-pass=machine-cp -mcp-use-is-copy-instr %s -o - | FileCheck %s

# All admitted inline-asm memory operands contain one GPR address. Native copy
# propagation must query that constraint, preserving the address and respecting
# fixed operands. Both generic copies and physical MOVrr reach the hook.
--- |
  define i32 @memory_m() { ret i32 0 }
  define i32 @memory_o() { ret i32 0 }
  define i32 @memory_v() { ret i32 0 }
  define i32 @address_p() { ret i32 0 }
  define i32 @fixed_address() { ret i32 0 }
...
---
name: memory_m
tracksRegLiveness: true
noVRegs: true
body: |
  bb.0:
    liveins: $r4, $pr
    renamable $r1 = MOVrr $r4
    INLINEASM &"mov.l $0,r0", sideeffect mayload attdialect, mem:m, killed renamable $r1, implicit-def $r0
    RTS implicit $pr, implicit $r0
...
# CHECK-LABEL: name: memory_m
# CHECK-NOT: MOVrr
# CHECK: INLINEASM &"mov.l $0,r0", sideeffect mayload attdialect, mem:m, $r4, implicit-def $r0
# CHECK-NEXT: RTS implicit $pr, implicit $r0

---
name: memory_o
tracksRegLiveness: true
noVRegs: true
body: |
  bb.0:
    liveins: $r4, $pr
    renamable $r1 = COPY $r4
    INLINEASM &"mov.l $0,r0", sideeffect mayload attdialect, mem:o, killed renamable $r1, implicit-def $r0
    RTS implicit $pr, implicit $r0
...
# CHECK-LABEL: name: memory_o
# CHECK-NOT: COPY
# CHECK: INLINEASM &"mov.l $0,r0", sideeffect mayload attdialect, mem:o, $r4, implicit-def $r0
# CHECK-NEXT: RTS implicit $pr, implicit $r0

---
name: memory_v
tracksRegLiveness: true
noVRegs: true
body: |
  bb.0:
    liveins: $r4, $pr
    renamable $r1 = MOVrr $r4
    INLINEASM &"mov.l $0,r0", sideeffect mayload attdialect, mem:v, killed renamable $r1, implicit-def $r0
    RTS implicit $pr, implicit $r0
...
# CHECK-LABEL: name: memory_v
# CHECK-NOT: MOVrr
# CHECK: INLINEASM &"mov.l $0,r0", sideeffect mayload attdialect, mem:v, $r4, implicit-def $r0
# CHECK-NEXT: RTS implicit $pr, implicit $r0

---
name: address_p
tracksRegLiveness: true
noVRegs: true
body: |
  bb.0:
    liveins: $r4, $pr
    renamable $r1 = MOVrr $r4
    INLINEASM &"mov $0,r0", sideeffect attdialect, mem:p, killed renamable $r1, implicit-def $r0
    RTS implicit $pr, implicit $r0
...
# CHECK-LABEL: name: address_p
# CHECK-NOT: MOVrr
# CHECK: INLINEASM &"mov $0,r0", sideeffect attdialect, mem:p, $r4, implicit-def $r0
# CHECK-NEXT: RTS implicit $pr, implicit $r0

---
name: fixed_address
tracksRegLiveness: true
noVRegs: true
body: |
  bb.0:
    liveins: $r4, $pr
    $r1 = MOVrr $r4
    INLINEASM &"mov.l $0,r0", sideeffect mayload attdialect, mem:m, killed $r1, implicit-def $r0
    RTS implicit $pr, implicit $r0
...
# CHECK-LABEL: name: fixed_address
# CHECK: $r1 = MOVrr $r4
# CHECK-NEXT: INLINEASM &"mov.l $0,r0", sideeffect mayload attdialect, mem:m, killed $r1, implicit-def $r0
# CHECK-NEXT: RTS implicit $pr, implicit $r0
