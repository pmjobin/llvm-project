# RUN: llc -mtriple=sh-unknown-elf -mcpu=sh2 -verify-machineinstrs -run-pass=prolog-epilog %s -o - | FileCheck %s
# RUN: llc -mtriple=shle-unknown-elf -mcpu=sh2 -verify-machineinstrs -run-pass=prolog-epilog %s -o - | FileCheck %s

--- |
  define i64 @i64_frame_56_60() {
    ret i64 0
  }
...
---
name:            i64_frame_56_60
tracksRegLiveness: true
noVRegs:         true
frameInfo:
  adjustsStack:    true
fixedStack:
  - { id: 0, type: default, offset: 44, size: 8, alignment: 4,
      stack-id: default, isImmutable: true, isAliased: false }
body:             |
  bb.0:
    ADJCALLSTACKDOWN 12, 0, implicit-def dead $r15, implicit $r15
    $r0 = MOVL_load_disp %fixed-stack.0, 0 :: (load (s32) from %fixed-stack.0)
    $r1 = MOVL_load_disp %fixed-stack.0, 4 :: (load (s32) from %fixed-stack.0 + 4)
    ADJCALLSTACKUP 12, 0, implicit-def dead $r15, implicit $r15
    RTS implicit $pr, implicit $r0, implicit $r1
...

# CHECK-LABEL: name:            i64_frame_56_60
# CHECK-LABEL: body:
# CHECK-NOT: ADJCALLSTACK
# CHECK: $r15 = ADDri $r15, -12
# CHECK-NEXT: CFI_INSTRUCTION adjust_cfa_offset 12
# CHECK-NEXT: $r0 = MOVL_load_disp $r15, 56
# CHECK-NEXT: $r1 = MOVL_load_disp $r15, 60
# CHECK-NEXT: $r15 = ADDri $r15, 12
# CHECK-NEXT: CFI_INSTRUCTION adjust_cfa_offset -12
