# CHECK-LABEL: name: dr_to_pair_undef
# CHECK: FLDS undef $fr0, implicit-def $fpul, implicit $fpscr
# CHECK: $r1 = STS_FPUL implicit $fpul
# CHECK: FLDS undef $fr1, implicit-def $fpul, implicit $fpscr
# CHECK: $r0 = STS_FPUL implicit $fpul
---
name: dr_to_pair_undef
tracksRegLiveness: true
noVRegs: true
body: |
  bb.0:
    liveins: $pr, $fpscr

    $r1, $r0 = DR_TO_GPR_PAIR_PSEUDO undef $dr0, implicit-def dead $fpul, implicit $fpscr
    RTS implicit $pr
...

# CHECK-LABEL: name: dr_to_pair_killed_undef
# CHECK: FLDS undef $fr0
# CHECK: FLDS killed undef $fr1
---
name: dr_to_pair_killed_undef
tracksRegLiveness: true
noVRegs: true
body: |
  bb.0:
    liveins: $pr, $fpscr

    $r1, $r0 = DR_TO_GPR_PAIR_PSEUDO killed undef $dr0, implicit-def dead $fpul, implicit $fpscr
    RTS implicit $pr
...

# CHECK-LABEL: name: dr_to_pair_live
# CHECK: FLDS $fr2
# CHECK: FLDS $fr3
# CHECK: $fr4 = FMOV_FR $fr2
# CHECK: $fr5 = FMOV_FR $fr3
# CHECK: $r7 = MOVrr $r5
---
name: dr_to_pair_live
tracksRegLiveness: true
noVRegs: true
body: |
  bb.0:
    liveins: $pr, $fpscr, $dr2

    $r5, $r6 = DR_TO_GPR_PAIR_PSEUDO $dr2, implicit-def dead $fpul, implicit $fpscr
    $dr4 = COPY $dr2
    $r7 = MOVrr $r5
    RTS implicit $pr
...

# CHECK-LABEL: name: dr_to_pair_killed
# CHECK: FLDS $fr2
# CHECK: FLDS killed $fr3
---
name: dr_to_pair_killed
tracksRegLiveness: true
noVRegs: true
body: |
  bb.0:
    liveins: $pr, $fpscr, $dr2

    $r5, $r6 = DR_TO_GPR_PAIR_PSEUDO killed $dr2, implicit-def dead $fpul, implicit $fpscr
    RTS implicit $pr
...

# CHECK-LABEL: name: pair_to_dr_both_undef
# CHECK: LDS_FPUL undef $r4
