# RUN: llc -mtriple=shle-unknown-none-elf -mcpu=sh4 -run-pass=sh-fpu-state,post-ra-pseudos -verify-machineinstrs %s -o - | FileCheck %s
# RUN: llc -mtriple=sh-unknown-none-elf -mcpu=sh4 -run-pass=sh-fpu-state,post-ra-pseudos -verify-machineinstrs %s -o - | FileCheck %s

# Physical data inputs retain undef through expansion; control state is defined.
# YAML block indentation follows MIR syntax.

# CHECK-LABEL: name: gpr_to_fr_undef
# CHECK: LDS_FPUL undef $r4
# CHECK: $fr2 = FSTS implicit $fpul
---
name: gpr_to_fr_undef
tracksRegLiveness: true
noVRegs: true
body: |
  bb.0:
    liveins: $pr, $fpscr

    $fr2 = GPR_TO_FR_PSEUDO undef $r4, implicit-def $fpul, implicit $fpscr
    RTS implicit $pr
...

# CHECK-LABEL: name: fr_to_gpr_undef
# CHECK: FLDS undef $fr2
# CHECK: $r4 = STS_FPUL implicit $fpul
---
name: fr_to_gpr_undef
tracksRegLiveness: true
noVRegs: true
body: |
  bb.0:
    liveins: $pr, $fpscr

    $r4 = FR_TO_GPR_PSEUDO undef $fr2, implicit-def $fpul, implicit $fpscr
    RTS implicit $pr
...

