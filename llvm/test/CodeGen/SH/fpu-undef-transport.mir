# CHECK-LABEL: name: same_source_live_False
# CHECK: LDS_FPUL $r4
# CHECK: $fr2 = FSTS
# CHECK: $fr3 = FSTS
# CHECK: $r5 = MOVrr $r4
---
name: same_source_live_False
tracksRegLiveness: true
noVRegs: true
body: |
  bb.0:
    liveins: $pr, $fpscr, $r4

    $dr2 = GPR_PAIR_TO_DR_PSEUDO killed undef $r4, $r4, implicit-def dead $fpul, implicit $fpscr
    $r5 = MOVrr $r4
    RTS implicit $pr
...

# CHECK-LABEL: name: same_source_live_True
# CHECK: LDS_FPUL $r4
# CHECK: $fr2 = FSTS
# CHECK: $fr3 = FSTS
# CHECK: $r5 = MOVrr $r4
---
name: same_source_live_True
tracksRegLiveness: true
noVRegs: true
body: |
  bb.0:
    liveins: $pr, $fpscr, $r4

    $dr2 = GPR_PAIR_TO_DR_PSEUDO $r4, killed undef $r4, implicit-def dead $fpul, implicit $fpscr
    $r5 = MOVrr $r4
    RTS implicit $pr
...

# CHECK-LABEL: name: scalar_defined_live_and_killed
# CHECK: LDS_FPUL $r4
# CHECK: FLDS killed $fr2
# CHECK: LDS_FPUL killed $r4
# CHECK: FTRC_FR $fr3
---
name: scalar_defined_live_and_killed
tracksRegLiveness: true
noVRegs: true
body: |
  bb.0:
    liveins: $pr, $fpscr, $r4

    $fr2 = GPR_TO_FR_PSEUDO $r4, implicit-def dead $fpul, implicit $fpscr
    $r5 = FR_TO_GPR_PSEUDO killed $fr2, implicit-def dead $fpul, implicit $fpscr
    $fr3 = I32_TO_F32_PSEUDO killed $r4, implicit-def dead $fpul, implicit-def $fpscr, implicit $fpscr
    $r6 = F32_TO_I32_PSEUDO $fr3, implicit-def dead $fpul, implicit-def $fpscr, implicit $fpscr
    RTS implicit $pr
...

# CHECK-LABEL: name: scalar_double_defined_alias
# CHECK: FLDS killed $fr2
# CHECK: $dr2 = FCNVSD
# CHECK: FCNVDS killed $dr2
# CHECK: $fr2 = FSTS
---
name: scalar_double_defined_alias
tracksRegLiveness: true
noVRegs: true
body: |
  bb.0:
    liveins: $pr, $fpscr, $fr2

    $dr2 = F32_TO_F64_PSEUDO killed $fr2, implicit-def dead $fpul, implicit-def $fpscr, implicit $fpscr
    $fr2 = F64_TO_F32_PSEUDO killed $dr2, implicit-def dead $fpul, implicit-def $fpscr, implicit $fpscr
    RTS implicit $pr
...

# CHECK-LABEL: name: scalar_store_undef
# CHECK: FMOV_S_STORE_ALIAS undef $fr{{[23]}}, $r4
# CHECK: FMOV_S_STORE_INDEXED_ALIAS undef $fr{{[23]}}, killed $r4
---
name: scalar_store_undef
tracksRegLiveness: true
noVRegs: true
body: |
  bb.0:
    liveins: $pr, $fpscr, $r4

    FMOV_D_STORE_SCALAR undef $dr2, killed $r4, implicit-def dead $r0, implicit $fpscr :: (volatile store (s64) into unknown-address, align 4)
    RTS implicit $pr
...

# CHECK-LABEL: name: undef_copies
# CHECK: $fr2 = KILL undef $fr0
# CHECK: $dr4 = KILL undef $dr0
---
name: undef_copies
tracksRegLiveness: true
noVRegs: true
body: |
  bb.0:
    liveins: $pr, $fpscr

    $fr2 = COPY undef $fr0
    $dr4 = COPY undef $dr0
    RTS implicit $pr
...
