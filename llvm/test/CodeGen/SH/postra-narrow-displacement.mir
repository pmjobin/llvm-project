# RUN: llc -mtriple=sh-unknown-elf -mcpu=sh2 -verify-machineinstrs -run-pass=sh-postra-peephole %s -o - | FileCheck %s
# RUN: llc -mtriple=shle-unknown-elf -mcpu=sh4 -verify-machineinstrs -run-pass=sh-postra-peephole %s -o - | FileCheck %s

--- |
  define void @fold_byte_load(ptr %p) { ret void }
  define void @fold_word_load(ptr %p) { ret void }
  define void @fold_odd_word_index(ptr %p) { ret void }
  define void @fold_non_r0_load(ptr %p) { ret void }
...
---
name:            fold_byte_load
tracksRegLiveness: true
noVRegs:         true
body:             |
  bb.0:
    liveins: $r1

    $r0 = COPY killed $r1
    $r0 = nuw ADDri $r0, 15
    $r0 = MOVB_load_reg killed $r0 :: (volatile load (s8) from %ir.p)
    RTS implicit $pr, implicit $r0
...

# CHECK-LABEL: name:            fold_byte_load
# CHECK-NOT: MOVrr
# CHECK-NOT: ADDri
# CHECK: $r0 = MOVB_load_disp killed $r1, 15 :: (volatile load (s8) from %ir.p)

---
name:            fold_word_load
tracksRegLiveness: true
noVRegs:         true
body:             |
  bb.0:
    liveins: $r14

    $r0 = MOVrr $r14
    $r0 = ADDri $r0, 30
    dead $r0 = MOVW_load_reg killed $r0 :: (load (s16) from %ir.p)
    RTS implicit $pr
...

# CHECK-LABEL: name:            fold_word_load
# CHECK-NOT: MOVrr
# CHECK-NOT: ADDri
# CHECK: dead $r0 = MOVW_load_disp $r14, 30 :: (load (s16) from %ir.p)

---
name:            fold_odd_word_index
tracksRegLiveness: true
noVRegs:         true
body:             |
  bb.0:
    liveins: $r1

    $r0 = MOVrr killed $r1
    $r0 = ADDri $r0, 3
    $r0 = MOVW_load_reg killed $r0 :: (load (s16) from %ir.p)
    RTS implicit $pr, implicit $r0
...

# CHECK-LABEL: name:            fold_odd_word_index
# CHECK-NOT: MOVrr
# CHECK-NOT: ADDri
# CHECK: $r0 = MOVri 3
# CHECK-NEXT: $r0 = MOVW_load_indexed killed $r1, implicit killed $r0

---
name:            fold_non_r0_load
tracksRegLiveness: true
noVRegs:         true
body:             |
  bb.0:
    liveins: $r1

    $r0 = MOVrr killed $r1
    $r0 = ADDri $r0, 4
    $r2 = MOVB_load_reg killed $r0 :: (load (s8) from %ir.p)
    RTS implicit $pr, implicit $r2
...

# CHECK-LABEL: name:            fold_non_r0_load
# CHECK-NOT: ADDri
# CHECK: $r0 = MOVB_load_disp killed $r1, 4
# CHECK-NEXT: $r2 = MOVrr killed $r0
