# NOTE: Assertions have been autogenerated by utils/update_mir_test_checks.py UTC_ARGS: --version 6
# Native load-result propagation keeps memory operations and their flags.
# Output uses distinguish forwarding from removal of a dead copy. Fixed and
# frame operands remain controls; an independent NOP is no longer a barrier.
# RUN: llc -mtriple=sh-unknown-elf -mcpu=sh2 -verify-machineinstrs -run-pass=machine-cp -mcp-use-is-copy-instr %s -o - | FileCheck %s
# RUN: llc -mtriple=shle-unknown-elf -mcpu=sh4 -verify-machineinstrs -run-pass=machine-cp -mcp-use-is-copy-instr %s -o - | FileCheck %s

--- |
  define void @fold_byte_register(ptr %p) { ret void }
  define void @fold_word_register(ptr %p) { ret void }
  define void @fold_long_register(ptr %p) { ret void }
  define void @fold_long_displacement(ptr %p) { ret void }
  define void @fold_indexed_to_r0(ptr %p) { ret void }
  define void @fold_indexed_to_base(ptr %p) { ret void }
  define void @keep_live_temporary(ptr %p) { ret void }
  define void @keep_narrow_displacement(ptr %p) { ret void }
  define void @fold_across_independent_instruction(ptr %p) { ret void }
  define void @keep_frame_flags(ptr %p) { ret void }
  define void @keep_bundle(ptr %p) { ret void }
...
---
name:            fold_byte_register
tracksRegLiveness: true
noVRegs:         true
body:             |
  bb.0:
    liveins: $r1, $pr

    ; CHECK-LABEL: name: fold_byte_register
    ; CHECK: liveins: $r1, $pr
    ; CHECK-NEXT: {{  $}}
    ; CHECK-NEXT: renamable $r4 = MOVB_load_reg killed $r1 :: (volatile load (s8) from %ir.p)
    ; CHECK-NEXT: RTS implicit $pr, implicit $r4
    renamable $r2 = MOVB_load_reg killed renamable $r1 :: (volatile load (s8) from %ir.p)
    renamable $r4 = MOVrr killed renamable $r2
    RTS implicit $pr, implicit $r4
...


