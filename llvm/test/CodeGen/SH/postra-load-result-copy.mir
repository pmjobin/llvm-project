    ; CHECK-NEXT:   $r2 = MOVL_load_reg killed $r1 :: (load (s32) from %ir.p)
    ; CHECK-NEXT:   dead $r4 = MOVrr internal killed $r2
    ; CHECK-NEXT: }
    BUNDLE {
      $r2 = MOVL_load_reg killed $r1 :: (load (s32) from %ir.p)
