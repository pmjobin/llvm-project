    ; CHECK-NEXT: NOP
    ; CHECK-NEXT: RTS implicit $pr, implicit $r4
    renamable $r2 = MOVB_load_reg killed $r1 :: (load (s8) from %ir.p)
    NOP
    $r4 = MOVrr killed renamable $r2
