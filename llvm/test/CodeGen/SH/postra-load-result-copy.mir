    ; CHECK-NEXT: {{  $}}
    ; CHECK-NEXT: $r2 = frame-setup MOVW_load_reg killed $r1 :: (load (s16) from %ir.p)
    ; CHECK-NEXT: $r4 = MOVrr killed $r2
    ; CHECK-NEXT: $r5 = MOVL_load_reg killed $r3 :: (load (s32) from %ir.p)
    ; CHECK-NEXT: $r6 = frame-destroy MOVrr killed $r5
    ; CHECK-NEXT: RTS implicit $pr, implicit $r4, implicit $r6
    $r2 = frame-setup MOVW_load_reg killed $r1 :: (load (s16) from %ir.p)
    $r4 = MOVrr killed $r2
    $r5 = MOVL_load_reg killed $r3 :: (load (s32) from %ir.p)
    $r6 = frame-destroy MOVrr killed $r5
    RTS implicit $pr, implicit $r4, implicit $r6
...


