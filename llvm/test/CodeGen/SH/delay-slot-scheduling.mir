---
name:            control_boundary
tracksRegLiveness: true
noVRegs:         true
body:             |
  bb.0:
    successors: %bb.1(0x40000000), %bb.2(0x40000000)
    liveins: $r4, $tbit

    $r0 = MOVrr $r4
    BT %bb.1, implicit $tbit
    BRA %bb.2

  bb.1:
    successors: %bb.2(0x80000000)
    BRA %bb.2

  bb.2:
...

