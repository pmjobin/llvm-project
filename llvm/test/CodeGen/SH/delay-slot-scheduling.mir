---
name:            size_boundary
tracksRegLiveness: true
noVRegs:         true
body:             |
  bb.0:
    successors: %bb.1(0x80000000)
    liveins: $r4, $r15

    $r0 = MOVrr $r4
    ADJCALLSTACKDOWN 0, 0, implicit-def $r15, implicit $r15
    BRA %bb.1

  bb.1:
...

# CHECK-LABEL: name:            size_boundary
