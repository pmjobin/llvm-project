# RUN: llc -mtriple=sh-unknown-elf -mcpu=sh2 -verify-machineinstrs -run-pass=sh-postra-peephole %s -o - | FileCheck %s
# RUN: llc -mtriple=shle-unknown-elf -mcpu=sh4 -verify-machineinstrs -run-pass=sh-postra-peephole %s -o - | FileCheck %s

--- |
  define void @fold_byte_load(ptr %p) { ret void }
  define void @fold_word_load(ptr %p) { ret void }
  define void @fold_byte_store(ptr %p) { ret void }
  define void @fold_word_store(ptr %p) { ret void }
...
---
name:            fold_byte_load
tracksRegLiveness: true
noVRegs:         true
body:             |
  bb.0:
    liveins: $r0, $r2

    $r0 = ADDrr killed $r0, killed $r2
    dead $r1 = MOVB_load_reg killed $r0 :: (load (s8) from %ir.p)
...

# CHECK-LABEL: name:            fold_byte_load
# CHECK-NOT: ADDrr
# CHECK: dead $r1 = MOVB_load_indexed killed $r2, implicit killed $r0

---
name:            fold_word_load
tracksRegLiveness: true
noVRegs:         true
body:             |
  bb.0:
    liveins: $r0, $r15

    $r0 = ADDrr killed $r0, $r15
    dead $r3 = MOVW_load_reg killed $r0 :: (load (s16) from %ir.p)
...

# CHECK-LABEL: name:            fold_word_load
# CHECK-NOT: ADDrr
# CHECK: dead $r3 = MOVW_load_indexed $r15, implicit killed $r0

---
name:            fold_byte_store
tracksRegLiveness: true
noVRegs:         true
body:             |
  bb.0:
    liveins: $r0, $r2, $r3

    $r0 = ADDrr killed $r0, killed $r2
    MOVB_store_reg killed $r3, killed $r0 :: (store (s8) into %ir.p)
...

# CHECK-LABEL: name:            fold_byte_store
# CHECK-NOT: ADDrr
# CHECK: MOVB_store_indexed killed $r3, killed $r2, implicit killed $r0

---
name:            fold_word_store
tracksRegLiveness: true
noVRegs:         true
body:             |
  bb.0:
    liveins: $r0, $r3, $r15

    $r0 = ADDrr killed $r0, $r15
    MOVW_store_reg killed $r3, killed $r0 :: (store (s16) into %ir.p)
...

# CHECK-LABEL: name:            fold_word_store
# CHECK-NOT: ADDrr
# CHECK: MOVW_store_indexed killed $r3, $r15, implicit killed $r0
