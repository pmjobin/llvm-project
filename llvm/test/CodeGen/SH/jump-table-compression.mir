    - id:              0
      blocks:          [ '%bb.2' ]
body:             |
  bb.0:
    successors: %bb.2
    liveins: $r4

    $r0 = MOVA <mcsymbol .Lmultiple_mmos_table>
    $r4 = SHLL2 killed $r4
    $r1 = MOVL_load_indexed killed $r4, implicit killed $r0 :: (dereferenceable invariant load (s32) from jump-table), (dereferenceable invariant load (s32) from jump-table)
    BRAF killed $r1, %jump-table.0, <mcsymbol .Lmultiple_mmos_base>

  bb.1 (align 4):
    SH_JUMPTABLE %jump-table.0, <mcsymbol .Lmultiple_mmos_table>, <mcsymbol .Lmultiple_mmos_base>, 4

  bb.2:
    RTS implicit $pr
...
