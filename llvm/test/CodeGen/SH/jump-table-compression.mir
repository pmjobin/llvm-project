  kind:            inline
  entries:
    - id:              0
      blocks:          [ '%bb.2' ]
body:             |
  bb.0:
    successors: %bb.2
    liveins: $r4

    $r0 = MOVA <mcsymbol .Lwrong_mmo_size_table>
    $r4 = SHLL2 killed $r4
    $r1 = MOVL_load_indexed killed $r4, implicit killed $r0 :: (dereferenceable invariant load (s16) from jump-table, align 4)
    BRAF killed $r1, %jump-table.0, <mcsymbol .Lwrong_mmo_size_base>

  bb.1 (align 4):
    SH_JUMPTABLE %jump-table.0, <mcsymbol .Lwrong_mmo_size_table>, <mcsymbol .Lwrong_mmo_size_base>, 4

  bb.2:
