# RUN: llc -mtriple=shle-unknown-linux-gnu -mcpu=sh4 -run-pass=finalize-isel -verify-machineinstrs %s -o - | FileCheck %s
# A custom inserter can split a select between CALLSEQ_START and CALLSEQ_END.
# The new blocks must preserve the active call-frame size for frame accesses.
--- |
  define i32 @select_stack_argument(i32 %a, i32 %b, i32 %c) { ret i32 0 }
...
---
name:            select_stack_argument
tracksRegLiveness: true
noPhis:          false
frameInfo:
  adjustsStack: true
  hasCalls: true
body: |
  bb.0:
    liveins: $r4, $r5, $r6
    %0:gpr = COPY $r4
    %1:gpr = COPY $r5
    %2:gpr = COPY $r6
    ADJCALLSTACKDOWN 20, 0, implicit-def dead $r15, implicit $r15
    %3:gpr = SELECT_PSEUDO %0, %1, %2
    MOVL_store_reg %3, $r15
    ADJCALLSTACKUP 20, 0, implicit-def dead $r15, implicit $r15
    $r0 = COPY %3
    RTS implicit $pr, implicit $r0
...
# CHECK-LABEL: name:            select_stack_argument
# CHECK: ADJCALLSTACKDOWN 20, 0
# CHECK: bb.1 {{.*}}call-frame-size 20
# CHECK: bb.2 {{.*}}call-frame-size 20
# CHECK: ADJCALLSTACKUP 20, 0
