# RUN: llc -mtriple=shle-unknown-none-elf -mcpu=sh4 -verify-machineinstrs -run-pass=postmisched %s -o - | FileCheck %s
# RUN: llc -mtriple=sh-unknown-none-elf -mcpu=sh4 -verify-machineinstrs -run-pass=postmisched,sh-delay-slot-filler %s -o - | FileCheck %s --check-prefixes=CHECK,SLOT
# RUN: llc -mtriple=shle-unknown-none-elf -mcpu=sh4 -verify-machineinstrs -run-pass=post-RA-sched -post-RA-scheduler=true %s -o - | FileCheck %s
# RUN: llc -mtriple=sh-unknown-none-elf -mcpu=sh4 -verify-machineinstrs -run-pass=post-RA-sched,sh-delay-slot-filler -post-RA-scheduler=true %s -o - | FileCheck %s --check-prefixes=CHECK,SLOT

# Explicit machine consumers make the architectural status order observable.
# Check relative orders, allowing independent integer and transport scheduling.
---
name: latest_status
tracksRegLiveness: true
noVRegs: true
body: |
  bb.0:
    liveins: $fr4, $fr5, $fpscr, $pr, $r4, $r5
    $fr4 = FMUL_FR $fr4, $fr5, implicit-def $fpscr, implicit $fpscr
    $r0 = STS_FPSCR implicit $fpscr
    $r4 = ADDrr $r4, $r5
    RTS implicit $pr, implicit $fr4, implicit $r0, implicit $r4
...
# CHECK-LABEL: name: latest_status
# CHECK: FMUL_FR {{.*}}implicit-def {{(dead )?}}$fpscr{{.*}}implicit $fpscr
# CHECK: STS_FPSCR implicit $fpscr

---
name: no_interleaving
tracksRegLiveness: true
noVRegs: true
body: |
  bb.0:
    liveins: $fr4, $fr5, $fpscr, $pr, $r1
    $r0 = STS_FPSCR implicit $fpscr
    $r0 = XORrr $r0, $r1
    LDS_FPSCR $r0, implicit-def $fpscr
    $fr4 = FADD_FR $fr4, $fr5, implicit-def $fpscr, implicit $fpscr
    $r0 = STS_FPSCR implicit $fpscr
    RTS implicit $pr, implicit $fr4, implicit $r0
...
# CHECK-LABEL: name: no_interleaving
# CHECK: STS_FPSCR implicit $fpscr
# CHECK: LDS_FPSCR
# CHECK: FADD_FR
# CHECK: STS_FPSCR implicit $fpscr

---
name: cause_overwrite_order
tracksRegLiveness: true
noVRegs: true
body: |
  bb.0:
    liveins: $fr0, $fr2, $fr4, $fr5, $fpscr, $pr
    $fr0 = FMUL_FR $fr0, $fr2, implicit-def $fpscr, implicit $fpscr
    $fr4 = FADD_FR $fr4, $fr5, implicit-def $fpscr, implicit $fpscr
    $r0 = STS_FPSCR implicit $fpscr
    RTS implicit $pr, implicit $fr0, implicit $fr4, implicit $r0
...
# CHECK-LABEL: name: cause_overwrite_order
# CHECK: FMUL_FR
# CHECK: FADD_FR
# CHECK: STS_FPSCR implicit $fpscr

---
name: full_memory_forms
tracksRegLiveness: true
noVRegs: true
body: |
  bb.0:
    liveins: $r4, $r5, $fr4, $fr5, $fpscr, $pr
    $fr4 = FADD_FR $fr4, $fr5, implicit-def $fpscr, implicit $fpscr
    $r4 = STS_L_FPSCR $r4, implicit $fpscr
    $r5 = LDS_L_FPSCR $r5, implicit-def $fpscr
    FCMP_GT_FR $fr4, $fr5, implicit-def $tbit, implicit-def $fpscr, implicit $fpscr
    $r0 = MOVT implicit $tbit
    $r2 = STS_FPSCR implicit $fpscr
    RTS implicit $pr, implicit $r0, implicit $r2
...
# CHECK-LABEL: name: full_memory_forms
# CHECK: FADD_FR
# CHECK: STS_L_FPSCR
# CHECK: LDS_L_FPSCR
# CHECK: FCMP_GT_FR {{.*}}implicit-def $tbit{{.*}}implicit-def {{(dead )?}}$fpscr{{.*}}implicit $fpscr
# CHECK: MOVT

---
name: independent_nonwriter_slot
tracksRegLiveness: true
noVRegs: true
body: |
  bb.0:
    liveins: $fr4, $fr5, $fpscr, $pr, $r4, $r5
    $fr4 = FMUL_FR $fr4, $fr5, implicit-def $fpscr, implicit $fpscr
    $r2 = STS_FPSCR implicit $fpscr
    $r4 = ADDrr $r4, $r5
    RTS implicit $pr, implicit $r4, implicit $r2, implicit $fr4
...
# CHECK-LABEL: name: independent_nonwriter_slot
# CHECK: FMUL_FR
# CHECK-DAG: STS_FPSCR
# SLOT-DAG: RTS {{.*}} {
# SLOT-DAG: $r4 = ADDrr

---
name: observe_before_update
tracksRegLiveness: true
noVRegs: true
body: |
  bb.0:
    liveins: $fr4, $fr5, $fpscr, $pr
    $r0 = STS_FPSCR implicit $fpscr
    $fr4 = FMUL_FR $fr4, $fr5, implicit-def $fpscr, implicit $fpscr
    $r2 = STS_FPSCR implicit $fpscr
    RTS implicit $pr, implicit $r0, implicit $r2, implicit $fr4
...
# CHECK-LABEL: name: observe_before_update
# CHECK: STS_FPSCR implicit $fpscr
# CHECK: FMUL_FR
# CHECK: STS_FPSCR implicit $fpscr
