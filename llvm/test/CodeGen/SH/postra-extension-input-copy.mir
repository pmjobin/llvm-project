# NOTE: Assertions have been autogenerated by utils/update_mir_test_checks.py UTC_ARGS: --version 6
# Native propagation can cross independent instructions and update several
# renamable users. Keep actual output uses, frame and bundle boundaries.
# RUN: llc -mtriple=sh-unknown-elf -mcpu=sh2 -verify-machineinstrs -run-pass=machine-cp -mcp-use-is-copy-instr %s -o - | FileCheck %s
# RUN: llc -mtriple=shle-unknown-elf -mcpu=sh4 -verify-machineinstrs -run-pass=machine-cp -mcp-use-is-copy-instr %s -o - | FileCheck %s

--- |
  define void @fold_byte_zero_extend() { ret void }
  define void @fold_word_zero_extend() { ret void }
  define void @fold_byte_sign_extend() { ret void }
  define void @fold_word_sign_extend() { ret void }
  define void @fold_into_source_register() { ret void }
  define void @preserve_live_source() { ret void }
  define void @forward_multiple_users() { ret void }
  define void @forward_across_independent_instruction() { ret void }
  define void @keep_frame_flag() { ret void }
  define void @keep_bundle() { ret void }
...
---
name:            fold_byte_zero_extend
tracksRegLiveness: true
noVRegs:         true
body:             |
  bb.0:
    liveins: $r0, $pr

    ; CHECK-LABEL: name: fold_byte_zero_extend
    ; CHECK: liveins: $r0, $pr
    ; CHECK-NEXT: {{  $}}
    ; CHECK-NEXT: $r2 = EXTUB $r0
    ; CHECK-NEXT: RTS implicit $pr, implicit $r2
    renamable $r1 = MOVrr killed $r0
    $r2 = EXTUB killed renamable $r1
    RTS implicit $pr, implicit $r2
...


