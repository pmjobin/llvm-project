# RUN: llc -mtriple=shle-unknown-linux-gnu -mcpu=sh4 -target-abi=gnu-hard-float -start-after=virt-reg-rewriter -verify-machineinstrs %s -o - | FileCheck %s
# RUN: llc -mtriple=sh-unknown-linux-gnu -mcpu=sh4 -target-abi=gnu-hard-float -start-after=virt-reg-rewriter -verify-machineinstrs %s -o /dev/null

# RUN: llc -mtriple=shle-unknown-linux-gnu -mcpu=sh4a -target-abi=gnu-hard-float -start-after=virt-reg-rewriter -verify-machineinstrs %s -o - | FileCheck %s --check-prefix=SH4A

# These are post-allocation inputs. A scalar spill has left PR1/SZ0 although
# the pre-RA transition was chosen for PR0/SZ0. Preserve the absolute target
# PR0/SZ1, recomputing its mask (24, not 16); FSCHG would trap in PR1.
--- |
  define void @stale_toggle() { ret void }
  define void @stale_immediate() { ret void }
  define void @stale_register() { ret void }
...
---
name: stale_toggle
tracksRegLiveness: true
noVRegs: true
body: |
  bb.0:
    liveins: $r4, $pr, $fpscr
    SET_FPSCR_MODE_TOGGLE 4, implicit-def $fpscr, implicit $fpscr
    $dr0, $r4 = FMOV_P_LOAD_DR $r4, implicit $fpscr :: (load (s64))
    RTS implicit $pr
...
# SH4A-LABEL: stale_toggle:
# SH4A: fpchg
# SH4A: fschg
# SH4A: fmov.d
# SH4A: fschg
# SH4A: fpchg
# SH4A: .size stale_toggle
# CHECK-LABEL: stale_toggle:
# CHECK-NOT: fschg
# CHECK: mov #24,r1
# CHECK: xor r1,r0
# CHECK: lds r0,fpscr
# CHECK: fmov.d
# CHECK-NOT: fschg
# CHECK: .size stale_toggle
---
name: stale_immediate
tracksRegLiveness: true
noVRegs: true
body: |
  bb.0:
    liveins: $r4, $pr, $fpscr
    TRANSITION_FPSCR_MODE 4, 16, implicit-def $r0, implicit-def $r1, implicit-def $fpscr, implicit $fpscr
    $dr0, $r4 = FMOV_P_LOAD_DR $r4, implicit $fpscr :: (load (s64))
    RTS implicit $pr
...
# SH4A-LABEL: stale_immediate:
# SH4A: fpchg
# SH4A: fschg
# SH4A: fmov.d
# SH4A: fschg
# SH4A: fpchg
# SH4A: .size stale_immediate
# CHECK-LABEL: stale_immediate:
# CHECK-NOT: mov #16,r1
# CHECK: mov #24,r1
# CHECK: xor r1,r0
# CHECK: lds r0,fpscr
# CHECK: fmov.d
# CHECK: .size stale_immediate
---
name: stale_register
tracksRegLiveness: true
noVRegs: true
body: |
  bb.0:
    liveins: $r4, $pr, $fpscr
    $r1 = MATERIALIZE_FPSCR_MASK 16
    TRANSITION_FPSCR_MODE_REG 4, $r1, 16, implicit-def $r0, implicit-def $fpscr, implicit $fpscr
    $dr0, $r4 = FMOV_P_LOAD_DR $r4, implicit $fpscr :: (load (s64))
    $r0 = MOVrr $r1
    RTS implicit $pr, implicit $r0
...
# The formerly reused R1 mask is still live: preserve it over the repair.
# SH4A-LABEL: stale_register:
# SH4A: fpchg
# SH4A: fschg
# SH4A: fmov.d
# SH4A: fschg
# SH4A: fpchg
# SH4A: .size stale_register
# CHECK-LABEL: stale_register:
# CHECK: mov #16,r1
# CHECK: mov.l r1,
# CHECK: mov #24,r1
# CHECK: xor r1,r0
# CHECK-DAG: lds r0,fpscr
# CHECK-DAG: mov.l {{.*}},r1
# CHECK: fmov.d
# CHECK: .size stale_register
