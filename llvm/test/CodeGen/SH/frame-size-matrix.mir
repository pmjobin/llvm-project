...

# CHECK-LABEL: name:            frame_0
# CHECK: stackSize:       0
# CHECK-LABEL: body:
# CHECK-NOT: ADDri $r15
# CHECK: RTS

# CHECK-LABEL: name:            frame_4
# CHECK: stackSize:       4
# CHECK: $r15 = frame-setup ADDri $r15, -4
# CHECK: $r15 = frame-destroy ADDri $r15, 4

# CHECK-LABEL: name:            frame_16
# CHECK: stackSize:       16
# CHECK: $r15 = frame-setup ADDri $r15, -16
# CHECK: $r15 = frame-destroy ADDri $r15, 16

# CHECK-LABEL: name:            frame_32
# CHECK: stackSize:       32
# CHECK: $r15 = frame-setup ADDri $r15, -32
# CHECK: $r15 = frame-destroy ADDri $r15, 32

# CHECK-LABEL: name:            frame_56
# CHECK: stackSize:       56
# CHECK: $r15 = frame-setup ADDri $r15, -56
# CHECK: $r15 = frame-destroy ADDri $r15, 56

# CHECK-LABEL: name:            frame_60
# CHECK: stackSize:       60
# CHECK: $r15 = frame-setup ADDri $r15, -60
# CHECK: $r15 = frame-destroy ADDri $r15, 60

# CHECK-LABEL: name:            frame_64
# CHECK: stackSize:       64
# CHECK: $r15 = frame-setup ADDri $r15, -64
# CHECK: $r15 = frame-destroy ADDri $r15, 64

# CHECK-LABEL: name:            frame_68
# CHECK: stackSize:       68
# CHECK: $r15 = frame-setup ADDri $r15, -68
# CHECK: $r15 = frame-destroy ADDri $r15, 68

# CHECK-LABEL: name:            frame_72
# CHECK: stackSize:       72
# CHECK: $r15 = frame-setup ADDri $r15, -72
# CHECK: $r15 = frame-destroy ADDri $r15, 72

# CHECK-LABEL: name:            frame_80
# CHECK: stackSize:       80
# CHECK: $r15 = frame-setup ADDri $r15, -80
# CHECK: $r15 = frame-destroy ADDri $r15, 80

# CHECK-LABEL: name:            frame_96
# CHECK: stackSize:       96
# CHECK: $r15 = frame-setup ADDri $r15, -96
# CHECK: $r15 = frame-destroy ADDri $r15, 96

# CHECK-LABEL: name:            frame_112
# CHECK: stackSize:       112
# CHECK: $r15 = frame-setup ADDri $r15, -112
# CHECK: $r15 = frame-destroy ADDri $r15, 112

# CHECK-LABEL: name:            frame_128
# CHECK: stackSize:       128
# CHECK: $r15 = frame-setup ADDri $r15, -128
# CHECK: $r15 = frame-destroy ADDri $r15, 127
# CHECK: $r15 = frame-destroy ADDri $r15, 1

# CHECK-LABEL: name:            frame_256
# CHECK: stackSize:       256
# CHECK: $r15 = frame-setup ADDri $r15, -128
# CHECK-NEXT: frame-setup CFI_INSTRUCTION def_cfa_offset 128
# CHECK-NEXT: $r15 = frame-setup ADDri $r15, -128
# CHECK-NEXT: frame-setup CFI_INSTRUCTION def_cfa_offset 256
# CHECK: $r15 = frame-destroy ADDri $r15, 127
# CHECK: $r15 = frame-destroy ADDri $r15, 127
# CHECK: $r15 = frame-destroy ADDri $r15, 2
