# RUN: llc -mtriple=sh-unknown-elf -mcpu=sh2 -verify-machineinstrs -run-pass=prolog-epilog %s -o - | FileCheck %s
# RUN: llc -mtriple=shle-unknown-elf -mcpu=sh2 -verify-machineinstrs -run-pass=prolog-epilog %s -o - | FileCheck %s
# RUN: llc -mtriple=sh-unknown-elf -mcpu=sh2 -verify-machineinstrs -run-pass=prolog-epilog %s -o %t.sh.mir
# RUN: llc -mtriple=sh-unknown-elf -mcpu=sh2 -verify-machineinstrs -start-after=prolog-epilog -filetype=obj %t.sh.mir -o /dev/null
# RUN: llc -mtriple=shle-unknown-elf -mcpu=sh2 -verify-machineinstrs -run-pass=prolog-epilog %s -o %t.shle.mir
# RUN: llc -mtriple=shle-unknown-elf -mcpu=sh2 -verify-machineinstrs -start-after=prolog-epilog -filetype=obj %t.shle.mir -o /dev/null

--- |
  define void @frame_0() { ret void }
  define void @frame_4() { ret void }
  define void @frame_16() { ret void }
  define void @frame_32() { ret void }
  define void @frame_56() { ret void }
  define void @frame_60() { ret void }
  define void @frame_64() { ret void }
  define void @frame_68() { ret void }
  define void @frame_72() { ret void }
  define void @frame_80() { ret void }
  define void @frame_96() { ret void }
  define void @frame_112() { ret void }
  define void @frame_128() { ret void }
  define void @frame_256() { ret void }
...
---
name: frame_0
tracksRegLiveness: true
noVRegs: true
body: |
  bb.0:
    RTS implicit $pr
...
---
name: frame_4
tracksRegLiveness: true
noVRegs: true
stack:
  - { id: 0, type: default, size: 4, alignment: 4 }
body: |
  bb.0:
    RTS implicit $pr
...
---
name: frame_16
tracksRegLiveness: true
noVRegs: true
stack:
  - { id: 0, type: default, size: 16, alignment: 4 }
body: |
  bb.0:
    RTS implicit $pr
...
---
