// NOTE: NO INCLUDE GUARD DESIRED!

#ifndef FUNCTION_PASS
#define FUNCTION_PASS(NAME, CREATE_PASS)
#endif
#undef FUNCTION_PASS

#ifndef MACHINE_FUNCTION_PASS
#define MACHINE_FUNCTION_PASS(NAME, CREATE_PASS)
#endif
MACHINE_FUNCTION_PASS("sh-delay-slot-filler", SHDelaySlotFillerPass())
MACHINE_FUNCTION_PASS("sh-isel", SHDAGToDAGISelPass(*this))
MACHINE_FUNCTION_PASS("sh-fpu-state", SHFPUStatePass())
MACHINE_FUNCTION_PASS("sh-inline-jump-tables", SHInlineJumpTablesPass())
MACHINE_FUNCTION_PASS("sh-compress-jump-tables", SHCompressJumpTablesPass())
MACHINE_FUNCTION_PASS("sh-literal-islands", SHLiteralIslandPass())
MACHINE_FUNCTION_PASS("sh-literal-pool-range-check",
                      SHLiteralPoolRangeCheckPass())
MACHINE_FUNCTION_PASS("sh-postra-peephole", SHPostRAPeepholePass())
#undef MACHINE_FUNCTION_PASS
